# Which vault subdir to sync from: 'scaffold' (demo content) or 'real' (your writing)
CONTENT_SOURCE=scaffold

# Verso, the chat. Key from https://aistudio.google.com/apikey
GEMINI_API_KEY=
# The MCP server's ask tool (src/pages/api/mcp.ts) still answers with Claude.
ANTHROPIC_API_KEY=
VOYAGE_API_KEY=
UPSTASH_VECTOR_REST_URL=
UPSTASH_VECTOR_REST_TOKEN=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Production Redis, read only by `npm run conversations` to download Verso
# transcripts. Prefixed so the dev server never connects to production.
# Upstash console > the database > REST API.
PROD_UPSTASH_REDIS_REST_URL=
PROD_UPSTASH_REDIS_REST_TOKEN=

# Telegram: each question Verso answers is sent to your phone, and a reply to
# one appears in that visitor's chat as you. Token from @BotFather (/newbot).
# TELEGRAM_OWNER_ID is your numeric user id, not a phone number or @username;
# @userinfobot will tell you yours. Send /start to your own bot once or every
# send comes back 403. TELEGRAM_WEBHOOK_SECRET is any long random string,
# echoed back by Telegram so the route can tell it is really Telegram calling.
# `npm run telegram:setup` registers the webhook; `-- --info` shows delivery errors.
TELEGRAM_BOT_TOKEN=
TELEGRAM_OWNER_ID=
TELEGRAM_WEBHOOK_SECRET=

# Spotify listening section on /now. Client ID/secret from
# https://developer.spotify.com/dashboard; refresh token via `npm run spotify-auth`.
# `npm run spotify` (also run on prebuild) caches top artists/albums to
# content/listening.json; without these vars the existing cache is kept.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REFRESH_TOKEN=

# Audit log (src/lib/audit.ts), Production only. In Vercel, set
# AUDIT_CHAIN_KEY (openssl rand -hex 32) for Production and CRON_SECRET
# (16+ characters) for the daily anchor cron. Never put AUDIT_CHAIN_KEY in
# this file: keep it in your password manager and pipe it into
# npm run audit:verify, which only needs the database's read-only token:
PROD_UPSTASH_REDIS_REST_READONLY_TOKEN=

# Kill switches (src/lib/switches.ts): off or force-off; unset means on.
# Set them with `npm run switch`, then redeploy.
SWITCH_CHAT=
SWITCH_VOICE=
SWITCH_TOOL_SEARCH_SITE=
SWITCH_TOOL_ASK_JODY=
