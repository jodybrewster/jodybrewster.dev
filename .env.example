# Which vault subdir to sync from: 'scaffold' (demo content) or 'real' (your writing)
CONTENT_SOURCE=scaffold

ANTHROPIC_API_KEY=
VOYAGE_API_KEY=
UPSTASH_VECTOR_REST_URL=
UPSTASH_VECTOR_REST_TOKEN=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Telegram handoff for the chat. A visitor's question is pushed to your phone
# and you can answer it as Verso before the model does. Token from @BotFather
# (/newbot). TELEGRAM_OWNER_ID is your numeric user id, not a phone number or a
# @username; @userinfobot will tell you yours. Send /start to your own bot once
# or every sendMessage comes back 403 - a bot cannot open a conversation.
# TELEGRAM_WEBHOOK_SECRET is any long random string, echoed back by Telegram on
# every delivery so the route can tell it is really Telegram calling.
# `npm run telegram:setup` registers the webhook and the command menu.
TELEGRAM_BOT_TOKEN=
TELEGRAM_OWNER_ID=
TELEGRAM_WEBHOOK_SECRET=

# Spotify listening section on /now. Client ID/secret from
# https://developer.spotify.com/dashboard; refresh token via `npm run spotify-auth`.
# `npm run spotify` (also run on prebuild) caches top artists/albums to
# content/listening.json; without these vars the existing cache is kept.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REFRESH_TOKEN=
