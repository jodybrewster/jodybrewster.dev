---
/**
 * Verso: the site's chat, fixed to the bottom of the browser on every page.
 * Collapsed, it's just the ask bar. Focus or submit expands a panel above it
 * with the conversation. Persists across dynamic (View Transitions) navigation.
 *
 * Answers stream from /api/chat, grounded in the site's own writing. Retrieval
 * plus a model can take a while on a cold start, so the client holds one turn
 * at a time and has a waiting state that never reads as a dead page.
 */
import VersoPartTemplates from './VersoPartTemplates.astro';
---
<div class="chat-dock" id="chat-dock" transition:persist="verso-dock">
  <div class="dock-panel" id="dock-panel" inert>
    <div class="dock-panel-head">
      <span class="dock-title"><svg class="icon sm"><use href="#i-bot"/></svg> Verso</span>
      <button class="dock-new" id="dock-new" type="button">New chat</button>
      <button class="dock-close" id="dock-close" type="button" aria-label="Close chat">
        <svg class="icon sm" viewBox="0 0 24 24" aria-hidden="true"><path d="m6 9 6 6 6-6" /></svg>
      </button>
    </div>
    <div class="dock-scroll" id="dock-scroll">
      <div class="dock-empty" id="dock-empty">
        <div class="dock-default-greeting">
          <p>Hi, I'm Verso. Ask me about Jody’s products, the decisions behind them, or how he takes an idea into production.</p>
          <div class="dock-quick">
            <button type="button" data-verso-open data-verso-prompt="What is Jody's experience?">Experience</button>
            <button type="button" data-verso-open data-verso-prompt="What are Jody's featured projects?">Featured work</button>
            <button type="button" data-verso-open data-verso-prompt="What is Jody's tech stack?">Tech stack</button>
          </div>
        </div>
        <div class="dock-page-welcome">
          <span class="dock-welcome-avatar" aria-hidden="true"><svg class="icon"><use href="#i-bot"/></svg></span>
          <div><p>Hi! I'm Verso. I can help you explore the products Jody has built, the decisions behind them, and the thinking that carried them into production. What would you like to know?</p>
            <div class="dock-suggestions">
              <button type="button" data-verso-open data-verso-prompt="What products has Jody built end to end?">What products have you built end to end?</button>
              <button type="button" data-verso-open data-verso-prompt="How does Jody take a product idea from prototype to production?">How do you take an idea to production?</button>
            </div>
          </div>
        </div>
      </div>
      <p class="dock-data-note">Verso is an AI. It answers from Jody's writing and work, and can get things wrong.</p>
      <div class="conversation" id="conversation" role="log" aria-label="Conversation with Verso" aria-live="polite" aria-relevant="additions"></div>
    </div>
  </div>

  <div class="dock-bar">
    <p class="dock-voice-status" id="dock-voice-status" role="status" hidden></p>
    <form class="input-row" id="chat-form">
      <span class="input-icon"><svg class="icon"><use href="#i-bot"/></svg></span>
      <!-- Who you're talking to, on the floating composer at desktop widths. The field's own label carries the name. -->
      <span class="dock-who" aria-hidden="true">
        <span class="dock-wave"><svg viewBox="0 0 28 28" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M2 12v4M6 8v12M10 3v22M14 10v8M18 6v16M22 11v6M26 13v2" /></svg></span>
        <span class="dock-who-name">Verso</span>
        <span class="dock-who-dot"></span>
      </span>
      <input type="text" id="chat-q" aria-label="Your message to Verso" autocomplete="off" maxlength="600" placeholder="Ask Verso about my work…" aria-controls="dock-panel" aria-expanded="false" />
      <!-- Voice: a live Gemini session, loaded on first tap. aria-pressed carries on/off; data-state adds connecting. -->
      <button type="button" class="dock-voice" id="dock-voice" aria-label="Talk to Verso" aria-pressed="false" data-state="idle">
        <svg class="icon" aria-hidden="true"><use href="#i-mic"/></svg>
      </button>
      <!-- Keep a separate label so a running response can expose Stop. -->
      <button type="submit" aria-label="Send message"><span class="submit-label">Ask</span> <svg class="icon sm"><use href="#i-send"/></svg></button>
    </form>
  </div>

  <!-- Case study parts Verso can place in the conversation. Inside the persisted
       dock so a part keeps its styles when the conversation follows the reader
       to another page. -->
  <VersoPartTemplates />

  <template id="tpl-retry">
    <div class="dock-recovery"><p class="dock-error" role="status"></p><button type="button" class="dock-retry">Try again</button></div>
  </template>
  <template id="tpl-you">
    <div class="turn you">
      <span class="who"><svg class="icon sm"><use href="#i-user"/></svg> You</span>
      <div class="said"></div>
    </div>
  </template>
  <!--
    The thinking indicator is authored here rather than built in the script so
    the scoped-style hash is compiled onto it; cloneNode carries the hash with
    it, where createElement would produce an unstyled span.
  -->
  <!--
    Cards the model can show inside a Verso turn (src/lib/card-render.ts).
    Templates for the same reason as the thinking indicator: the scoped style
    hash has to be on the markup. The renderer fills [data-field] slots with
    textContent only and removes the ones a card leaves empty.
  -->
  <template id="tpl-card-work">
    <a class="vcard vcard-work">
      <span class="vcard-body">
        <span class="vcard-kicker">Case study</span>
        <span class="vcard-title" data-field="title"></span>
        <span class="vcard-text" data-field="summary"></span>
        <span class="vcard-meta"><span data-field="role"></span><span data-field="duration"></span><span data-field="sector"></span></span>
      </span>
      <svg class="icon sm vcard-go" aria-hidden="true"><use href="#i-arrow-right"/></svg>
    </a>
  </template>
  <template id="tpl-card-article">
    <a class="vcard vcard-article">
      <img class="vcard-image" alt="" width="64" height="64" loading="lazy" decoding="async" />
      <span class="vcard-body">
        <span class="vcard-kicker"><span data-field="label"></span><time data-field="date"></time></span>
        <span class="vcard-title" data-field="title"></span>
        <span class="vcard-text" data-field="description"></span>
      </span>
      <svg class="icon sm vcard-go" aria-hidden="true"><use href="#i-arrow-right"/></svg>
    </a>
  </template>
  <template id="tpl-card-note">
    <a class="vcard vcard-note">
      <span class="vcard-body">
        <span class="vcard-kicker"><span>Lab note</span><time data-field="date"></time><span class="vcard-state" data-field="status"></span></span>
        <span class="vcard-title" data-field="title"></span>
      </span>
      <svg class="icon sm vcard-go" aria-hidden="true"><use href="#i-arrow-right"/></svg>
    </a>
  </template>
  <template id="tpl-card-now">
    <a class="vcard vcard-now">
      <span class="vcard-body">
        <span class="vcard-kicker"><span>Now</span><time data-field="updated"></time></span>
        <span class="vcard-title" data-field="title"></span>
        <span class="vcard-text" data-field="excerpt"></span>
      </span>
      <svg class="icon sm vcard-go" aria-hidden="true"><use href="#i-arrow-right"/></svg>
    </a>
  </template>
  <template id="tpl-card-page">
    <a class="vcard vcard-page">
      <span class="vcard-body">
        <span class="vcard-kicker" data-field="path"></span>
        <blockquote class="vcard-quote" data-field="quote"></blockquote>
        <span class="vcard-title" data-field="title"></span>
        <span class="vcard-text" data-field="description"></span>
      </span>
      <svg class="icon sm vcard-go" aria-hidden="true"><use href="#i-arrow-right"/></svg>
    </a>
  </template>
  <template id="tpl-site">
    <div class="turn site">
      <span class="who"><svg class="icon sm"><use href="#i-bot"/></svg> Verso</span>
      <div class="said">
        <div class="answer">
          <span class="thinking" aria-live="polite">
            <span class="dot"></span><span class="dot"></span><span class="dot"></span>
            <span class="waited" hidden>Taking a little longer…</span>
          </span>
        </div>
      </div>
    </div>
  </template>
</div>

<style>
  .dock-page-welcome { display: none; }
  .dock-who { display: none; }
  .chat-dock {
    position: fixed;
    left: 0; right: 0; bottom: 0;
    z-index: 40;
    background: var(--paper);
    border-top: 1px solid var(--rule);
    box-shadow: 0 -14px 34px -20px rgba(20, 24, 29, 0.3);
  }
  .dock-bar {
    padding: 14px 32px calc(14px + env(safe-area-inset-bottom));
  }
  .dock-bar .input-row {
    max-width: var(--measure);
    margin: 0 auto;
  }

  /* Panel expands above the bar; collapsed by default. */
  .dock-panel {
    max-height: 0;
    overflow: hidden;
    opacity: 0;
    transform: translateY(12px);
    transition: max-height 240ms var(--ease-out), opacity 200ms var(--ease-out), transform 200ms var(--ease-out);
    border-bottom: 1px solid transparent;
  }
  .chat-dock.open .dock-panel {
    max-height: min(62vh, 640px);
    opacity: 1;
    transform: translateY(0);
    border-bottom-color: var(--rule);
  }
  .dock-panel-head {
    max-width: var(--measure);
    margin: 0 auto;
    padding: 16px 32px 4px;
    display: flex;
    align-items: center;
    justify-content: space-between;
  }
  .dock-title {
    font-family: var(--mono);
    font-size: var(--t-eyebrow);
    letter-spacing: var(--ls-eyebrow);
    text-transform: uppercase;
    color: var(--accent);
    font-weight: 500;
    display: inline-flex;
    align-items: center;
    gap: 8px;
  }
  .dock-close {
    background: transparent;
    border: none;
    cursor: pointer;
    color: var(--ink-faint);
    display: inline-flex;
    padding: 6px;
    border-radius: 6px;
    transition: color .15s ease, background-color .15s ease;
  }
  .dock-close:hover { color: var(--accent); background: var(--paper-warm); }
  .dock-scroll {
    max-width: var(--measure);
    margin: 0 auto;
    padding: 12px 32px 24px;
    overflow-y: auto;
    max-height: calc(min(62vh, 640px) - 44px);
  }
  .dock-empty p {
    font-family: var(--sans);
    font-size: 14.5px;
    line-height: 1.6;
    color: var(--ink-soft);
    margin: 0 0 16px;
    max-width: 60ch;
  }

  /* Waiting state. Ink-faint rather than accent: the dock already spends the
     accent on the title, the speaker label, the submit button and the source
     tags, and a pulsing fifth use would be the loudest thing on the page. */
  .thinking {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    padding: 5px 0;
  }
  .thinking .dot {
    width: 5px;
    height: 5px;
    border-radius: 99px;
    background: var(--ink-faint);
    opacity: 0.22;
    animation: thinking-pulse 1200ms cubic-bezier(0.4, 0, 0.2, 1) infinite;
  }
  .thinking .dot:nth-child(2) { animation-delay: 160ms; }
  .thinking .dot:nth-child(3) { animation-delay: 320ms; }
  @keyframes thinking-pulse {
    0%, 70%, 100% { opacity: 0.22; }
    35% { opacity: 1; }
  }
  /* Shown only once the wait is long enough to read as a stall. Mono, because
     this is the interface reporting on itself, not Verso speaking. No display
     property: the `hidden` attribute has to keep winning until the script
     drops it. */
  .thinking .waited {
    font-family: var(--mono);
    font-size: var(--t-eyebrow);
    letter-spacing: var(--ls-eyebrow);
    text-transform: uppercase;
    color: var(--ink-faint);
    margin-left: 8px;
  }
  @media (prefers-reduced-motion: reduce) {
    /* Still legible as three dots, just not moving. */
    .thinking .dot { animation: none; opacity: 0.5; }
    .dock-panel { transform: none; transition: opacity 150ms ease; }
  }

  /* Cards: a piece of the site, shown inside a Verso turn. The same raised
     surface and 1px rule as the sources block, so a card reads as part of the
     answer rather than a widget laid over it. Accent only on hover and focus. */
  .vcard {
    display: flex;
    align-items: flex-start;
    gap: 12px;
    max-width: 460px;
    margin: 0 0 12px;
    padding: 12px 14px;
    border: 1px solid var(--rule);
    border-radius: 10px;
    background: var(--paper-warm);
    color: var(--ink);
    text-decoration: none;
    transition: border-color 150ms ease, transform 150ms var(--ease-out);
  }
  .answer + .vcard { margin-top: 4px; }
  .vcard:hover { border-color: var(--accent); transform: translateY(-2px); }
  .vcard:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }
  .vcard-body { display: flex; flex-direction: column; gap: 3px; flex: 1; min-width: 0; }
  .vcard-kicker {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 2px 8px;
    font: 500 var(--t-micro)/1.5 var(--mono);
    letter-spacing: var(--ls-eyebrow);
    text-transform: uppercase;
    color: var(--ink-faint);
    overflow-wrap: anywhere;
  }
  .vcard-kicker time::before { content: "\00B7"; margin-right: 8px; color: var(--ink-faint); }
  .vcard-title, .vcard-text, .vcard-meta, .vcard-quote {
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
    line-clamp: 2;
    overflow: hidden;
    overflow-wrap: anywhere;
  }
  .vcard-title { font: 600 14px/1.35 var(--sans); color: var(--ink); }
  .vcard-text { font: 400 12.5px/1.5 var(--sans); color: var(--ink-soft); }
  .vcard-meta { margin-top: 2px; font: 400 11.5px/1.5 var(--sans); color: var(--ink-soft); -webkit-line-clamp: 1; line-clamp: 1; }
  .vcard-meta > span + span::before { content: "\00B7"; margin: 0 6px; color: var(--ink-faint); }
  .vcard-image {
    flex-shrink: 0;
    width: 64px;
    height: 64px;
    object-fit: cover;
    border-radius: 4px;
    border: 1px solid var(--rule);
    background: var(--paper);
  }
  .vcard-state {
    padding: 0 7px;
    border: 1px solid var(--rule);
    border-radius: 99px;
    letter-spacing: .04em;
    color: var(--ink-soft);
  }
  .vcard-state[data-status="evergreen"] { color: var(--accent); }
  .vcard-quote {
    margin: 2px 0 4px;
    padding-left: 10px;
    border-left: 1px solid var(--rule);
    font: italic 400 13px/1.55 var(--sans);
    color: var(--ink);
    -webkit-line-clamp: 3;
    line-clamp: 3;
  }
  .vcard-go { flex-shrink: 0; align-self: center; color: var(--ink-faint); transition: color 150ms ease, transform 150ms var(--ease-out); }
  .vcard:hover .vcard-go { color: var(--accent); transform: translateX(2px); }
  @media (prefers-reduced-motion: reduce) {
    .vcard, .vcard-go { transition: border-color 150ms ease, color 150ms ease; }
    .vcard:hover, .vcard:hover .vcard-go { transform: none; }
  }
  @media (max-width: 720px) {
    .vcard { max-width: none; padding: 11px 12px; gap: 10px; }
    .vcard-image { width: 56px; height: 56px; }
  }
  /* The narrowest phones: the whole card is the link, so the arrow gives its
     room to the date line rather than wrapping it. */
  @media (max-width: 380px) {
    .vcard-go { display: none; }
    .vcard-image { width: 48px; height: 48px; }
  }

  /* One turn at a time, so the bar reads as unavailable while it runs. */
  .input-row input:disabled,
  .input-row button:disabled {
    opacity: 0.5;
    cursor: default;
  }
  .input-row button:disabled:hover { background: var(--accent); }

  @media (max-width: 720px) {
    .dock-bar { padding: 12px 20px calc(12px + env(safe-area-inset-bottom)); }
    .dock-panel-head { padding: 14px 20px 4px; }
    .dock-scroll { padding: 12px 20px 20px; }
  }
</style>

<script>
  import { initChatDock } from '../lib/chat-dock-client';
  initChatDock();
  document.addEventListener('astro:page-load', initChatDock);
</script>
