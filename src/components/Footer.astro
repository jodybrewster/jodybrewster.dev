---
const year = new Date().getFullYear();
---
<footer class="foot">
  <span class="left">
    <svg class="icon sm"><use href="#i-mark"/></svg>
    &copy; Jody {year} &mdash; personal site, written and tended in Obsidian.
  </span>
  <span class="right">
    <a href="/writing">
      <svg class="icon sm"><use href="#i-book"/></svg> Writing
    </a>
    <a href="/llms.txt">
      <svg class="icon sm"><use href="#i-file"/></svg> /llms.txt
    </a>
    <a href="/rss.xml">
      <svg class="icon sm"><use href="#i-rss"/></svg> RSS
    </a>
    <a href="https://github.com/jodybrewster" rel="me">
      <svg class="icon sm"><use href="#i-code"/></svg> GitHub
    </a>
    <a href="https://www.linkedin.com/in/jodybrewster" rel="me">
      <svg class="icon sm"><use href="#i-user"/></svg> LinkedIn
    </a>
    <a href="mailto:jody@jodybrewster.dev">
      <svg class="icon sm"><use href="#i-mail"/></svg> Email
    </a>
    <a href="/privacy">
      <svg class="icon sm"><use href="#i-shield"/></svg> Privacy
    </a>
  </span>
  <p class="credit">AI Slop made with <svg class="icon sm heart" aria-hidden="true"><use href="#i-heart"/></svg><span class="visually-hidden">love</span> in Miami</p>
</footer>

<style>
  /* Its own line under the footer row: flex-basis 100% forces the wrap. */
  .credit { flex-basis: 100%; display: flex; align-items: center; justify-content: center; gap: 10px; margin: 0; font-size: 16px; font-weight: 500; letter-spacing: .18em; text-transform: uppercase; color: var(--ui-ink, #f4f7fb); }
  .heart { width: 20px; height: 20px; fill: #ff4fb6; stroke: none; filter: drop-shadow(0 0 6px rgb(255 47 166 / .7)); }
</style>
