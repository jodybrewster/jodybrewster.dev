---
import { getCollection } from 'astro:content';
import BrandMark from './BrandMark.astro';

const pathname = Astro.url.pathname;

const publishedWriting = await getCollection('writing', e => e.data.status === 'published');
const hasWriting = publishedWriting.length > 0;

const links = [
  { href: '/writing',  label: 'Writing',  icon: 'i-book',     hidden: !hasWriting },
  { href: '/work',     label: 'Briefs',   icon: 'i-file',     hidden: false },
  { href: '/portfolio', label: 'Portfolio', icon: 'i-brief',  hidden: false },
  { href: '/research', label: 'Research', icon: 'i-compass',  hidden: false },
  { href: '/agent',    label: 'Agent',    icon: 'i-terminal', hidden: false },
  { href: '/library',  label: 'Library',  icon: 'i-layers',   hidden: false },
  { href: '/about',    label: 'About',    icon: 'i-user',     hidden: false },
];

function isActive(href: string): boolean {
  if (href === '/writing') {
    return pathname === '/home' || pathname === '/writing' || pathname.startsWith('/writing/');
  }
  return pathname === href || pathname.startsWith(href + '/');
}
---
<header class="mast">
  <a href="/home" class="mark">
    <span class="glyph">
      <BrandMark />
    </span>
    <span class="mark-text">
      <span class="name">Jody Brewster</span>
      <span class="tag">notes on experience architecture</span>
    </span>
  </a>
  <div class="nav-right">
    <nav class="primary" id="primary-nav">
      {links.filter(l => !l.hidden).map(({ href, label, icon }) => (
        <a
          href={href}
          class={isActive(href) ? 'active' : undefined}
          data-astro-prefetch={href === '/library' ? 'hover' : undefined}
          {...href === '/library' ? { 'data-astro-reload': true } : {}}
        >
          <svg class="icon sm"><use href={`#${icon}`}/></svg>{label}
        </a>
      ))}
    </nav>
    <button class="nav-toggle" id="nav-toggle" aria-label="Menu" aria-expanded="false" aria-controls="primary-nav">
      <span class="bar"></span>
      <span class="bar"></span>
    </button>
  </div>
</header>

<style>
  .mark .glyph {
    --brand-mark-width:48px;
    --brand-mark-height:39px;
    width: 48px;
    height: 39px;
    border: none;
    border-radius: 0;
  }
  .mark .glyph :global(img) {
    width: 100%;
    height: 100%;
    display: block;
  }
  .mark-text {
    display: flex;
    flex-direction: column;
    gap: 2px;
    line-height: 1.1;
  }
  .mark-text .name {
    font-family: var(--display);
    font-weight: 500;
    font-variation-settings: "opsz" 30;
    font-size: 21px;
    letter-spacing: -0.01em;
    color: var(--ink);
  }
  .mark-text .tag {
    font-family: var(--display);
    font-weight: 400;
    font-variation-settings: "opsz" 14;
    font-size: 12.5px;
    letter-spacing: 0.04em;
    color: var(--ink-faint);
  }
  header.mast { position: relative; }
  .nav-right {
    display: flex;
    align-items: center;
    gap: 4px;
  }
  .nav-toggle {
    display: none;
    width: 40px;
    height: 40px;
    align-items: center;
    justify-content: center;
    flex-direction: column;
    gap: 5px;
    background: transparent;
    border: none;
    cursor: pointer;
    border-radius: 8px;
    transition: background-color .15s ease;
  }
  .nav-toggle:hover { background: var(--paper-warm); }
  .nav-toggle .bar {
    width: 18px;
    height: 1.5px;
    background: var(--ink-soft);
    border-radius: 2px;
    transition: transform .22s cubic-bezier(0.4, 0, 0.2, 1), opacity .18s ease;
  }
  .nav-toggle[aria-expanded="true"] .bar:nth-child(1) { transform: translateY(3.25px) rotate(45deg); }
  .nav-toggle[aria-expanded="true"] .bar:nth-child(2) { transform: translateY(-3.25px) rotate(-45deg); }

  @media (max-width: 720px) {
    .mark-text .tag { display: none; }
    .nav-toggle { display: inline-flex; }
    nav.primary {
      position: absolute;
      top: calc(100% + 1px);
      right: 0;
      left: 0;
      flex-direction: column;
      gap: 2px;
      background: var(--paper);
      border-bottom: 1px solid var(--rule);
      padding: 10px 20px 18px;
      box-shadow: 0 16px 32px -20px rgba(20, 24, 29, 0.4);
      opacity: 0;
      transform: translateY(-8px);
      pointer-events: none;
      transition: opacity .2s ease, transform .2s cubic-bezier(0.4, 0, 0.2, 1);
      z-index: 30;
    }
    nav.primary.open {
      opacity: 1;
      transform: none;
      pointer-events: auto;
    }
    nav.primary a {
      font-size: 15px;
      padding: 11px 12px;
      border-radius: 8px;
    }
  }
</style>

<script>
  // The menu is delegated and looks its elements up fresh
  // each time. Holding a reference to the button across a swap is holding a
  // reference to a discarded one.
  const menuEls = () => ({
    toggle: document.getElementById('nav-toggle'),
    panel: document.getElementById('primary-nav'),
  });

  function setMenu(open: boolean) {
    const { toggle, panel } = menuEls();
    toggle?.setAttribute('aria-expanded', String(open));
    panel?.classList.toggle('open', open);
  }

  document.addEventListener('click', (e) => {
    const target = e.target as Element | null;

    if (target?.closest?.('#nav-toggle')) {
      setMenu(menuEls().toggle?.getAttribute('aria-expanded') !== 'true');
      return;
    }

    // Dismiss on outside tap.
    const { panel } = menuEls();
    if (panel?.classList.contains('open') && !panel.contains(target as Node)) {
      setMenu(false);
    }
  });

  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') setMenu(false);
  });

  // Delegated: view transitions swap the nav out, taking element-bound
  // listeners with it. pointerover and focusin both bubble; pointerenter does not.
  const wantsLibrary = (e: Event) =>
    (e.target as Element | null)?.closest?.('a[href="/library"]') != null;

  // The shelf carries ~150KB gzipped of Three.js. Astro's prefetch pulls the
  // shelf document on hover, but the document is not the slow part, so read
  // the module URLs out of it and pull those into the cache as well. They are
  // content-hashed, hence parsing rather than a hardcoded path.
  let warmed = false;

  async function warmLibrary() {
    if (warmed) return;
    warmed = true;
    try {
      // force-cache: Astro's hover prefetch has usually just fetched this, and
      // the point is to read its script tags, not to fetch the page again.
      const res = await fetch('/library', { cache: 'force-cache' });
      if (!res.ok) return;
      const doc = new DOMParser().parseFromString(await res.text(), 'text/html');
      for (const script of doc.querySelectorAll('script[type="module"][src]')) {
        const src = script.getAttribute('src');
        if (!src) continue;
        const link = document.createElement('link');
        link.rel = 'prefetch';
        link.as = 'script';
        link.href = new URL(src, location.origin).href;
        document.head.append(link);
      }
    } catch {
      /* Best effort. Without it the shelf just loads cold. */
    }
  }

  document.addEventListener('pointerover', (e) => { if (wantsLibrary(e)) warmLibrary(); });
  document.addEventListener('focusin', (e) => { if (wantsLibrary(e)) warmLibrary(); });
</script>
