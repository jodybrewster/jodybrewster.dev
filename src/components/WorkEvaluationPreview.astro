---
interface Props { compact?: boolean; }
const { compact = false } = Astro.props;
---
<div class:list={['work-evaluation', { compact }]} aria-label="Evaluation framework: refill, transfer, and adherence conversations assessed for safety, accuracy, comprehension, and dignity">
  <div class="evaluation-toolbar"><span class="evaluation-dot" aria-hidden="true"></span><span>Conversation quality</span><span class="evaluation-type">Evaluation framework</span></div>
  <div class="evaluation-body">
    <div class="evaluation-conversations">
      <p class="evaluation-label">Real conversations</p>
      {['Refill requests', 'Transfer initiation', 'Adherence check-ins'].map((label, i) => <div class="evaluation-conversation"><span class="conversation-marker" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span><span>{label}</span></div>)}
      <p class="evaluation-footnote">Voice & text · ~600 reviewed</p>
    </div>
    <div class="evaluation-rubric">
      <p class="evaluation-label">The quality rubric</p>
      {['Safety', 'Accuracy', 'Comprehension', 'Dignity'].map((label, i) => <div class="evaluation-rule"><span>{label}</span><span aria-hidden="true">0{i + 1}</span></div>)}
      <p class="evaluation-footnote">22 rules · Human judgment first</p>
    </div>
  </div>
</div>

<style>
  .work-evaluation { width: 100%; height: 100%; background: var(--studio-surface); color: var(--studio-ink); padding: 28px; display: flex; flex-direction: column; justify-content: center; font-family: var(--sans); }
  .evaluation-toolbar { display: flex; align-items: center; gap: 9px; padding-bottom: 20px; font-size: 13px; font-weight: 650; }
  .evaluation-dot { width: 8px; height: 8px; background: var(--studio-cyan); border-radius: 50%; }
  .evaluation-type { margin-left: auto; font-size: 8px; text-transform: uppercase; letter-spacing: .12em; color: var(--studio-muted); }
  .evaluation-body { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; }
  .evaluation-conversations, .evaluation-rubric { border: 1px solid var(--studio-rule); border-radius: 10px; padding: 16px; }
  .evaluation-label { margin: 0 0 15px; color: var(--studio-muted); font-size: 9px; letter-spacing: .1em; text-transform: uppercase; font-weight: 600; }
  .evaluation-conversation { display: flex; align-items: center; gap: 10px; margin-bottom: 15px; font-size: 11px; font-weight: 500; }
  .conversation-marker { display: grid; place-items: center; width: 26px; height: 26px; flex-shrink: 0; border: 1px solid var(--studio-rule); border-radius: 50%; font-size: 9px; color: var(--studio-cyan); background: var(--studio-raised); }
  .evaluation-rule { display: flex; align-items: center; justify-content: space-between; padding: 9px 10px; margin-bottom: 7px; font-size: 11px; font-weight: 500; border-radius: 7px; background: var(--studio-raised); }
  .evaluation-rule span + span { color: var(--studio-purple); font-size: 9px; }
  .evaluation-footnote { color: var(--studio-muted); font-size: 8px; margin: 14px 0 0; }
  .compact { padding: 16px 22px; }
  .compact .evaluation-toolbar { padding-bottom: 12px; font-size: 11px; }
  .compact .evaluation-type { font-size: 7px; }
  .compact .evaluation-conversations, .compact .evaluation-rubric { padding: 10px; }
  .compact .evaluation-label { margin-bottom: 8px; }
  .compact .evaluation-conversation { margin-bottom: 7px; font-size: 10px; }
  .compact .conversation-marker { width: 20px; height: 20px; font-size: 8px; }
  .compact .evaluation-rule { padding: 5px 8px; margin-bottom: 5px; font-size: 10px; }
  .compact .evaluation-footnote { display: none; }
  @media (max-width: 720px) {
    .work-evaluation { padding: 20px 14px; }
    .evaluation-body { gap: 10px; }
    .evaluation-conversations, .evaluation-rubric { padding: 10px; }
    .evaluation-type { display: none; }
    .evaluation-conversation { font-size: 10px; gap: 6px; }
    .evaluation-rule { font-size: 10px; }
    .evaluation-footnote { line-height: 1.7; }
  }
</style>
