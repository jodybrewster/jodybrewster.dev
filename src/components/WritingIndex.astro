---
import { getCollection } from 'astro:content';
import Icon from './Icon.astro';
import { articleImage } from '../lib/article-images';
import { mediaTransitionName } from '../lib/transition-names';

interface Props { researchOnly?: boolean; }
const { researchOnly = false } = Astro.props;
const [essays, research] = await Promise.all([
  researchOnly ? Promise.resolve([]) : getCollection('writing', entry => entry.data.status === 'published'),
  getCollection('research', entry => entry.data.publish),
]);
const categoryDefinitions = [
  { id: 'architecture', label: 'Architecture', pattern: /architecture|systems|framework|mcp|platform|knowledge|snowflake|stack|codebase/i },
  { id: 'ai', label: 'AI', pattern: /agent|\bai\b|llm|cortex|claude|snowflake|eval/i },
  { id: 'product', label: 'Product', pattern: /product|design|interface|generative|experience|portfolio|frontend/i },
  { id: 'craft', label: 'Craft', pattern: /methodology|design-systems|documentation|writing|design-engineering|senior-practice|judgment|quality/i },
];
const articles = [
  ...essays.map(entry => ({ slug: entry.id, title: entry.data.title, description: entry.data.description, tags: entry.data.tags, pillar: entry.data.pillar, date: entry.data.date, href: `/writing/${entry.id}`, kind: 'Essay' })),
  ...research.map(entry => ({ slug: entry.id, title: entry.data.title, description: entry.data.description, tags: entry.data.tags, pillar: entry.data.pillar, date: entry.data.pubDate, href: `/research/${entry.id}`, kind: 'Research' })),
].sort((a, b) => b.date.valueOf() - a.date.valueOf() || a.title.localeCompare(b.title)).map(entry => {
  const search = [entry.title, entry.description, ...entry.tags, entry.pillar ?? ''].join(' ');
  return { ...entry, search: search.toLocaleLowerCase(), categories: categoryDefinitions.filter(category => category.pattern.test(search)).map(category => category.id), image: articleImage(entry.kind === 'Research' ? 'research' : 'writing', entry.slug) };
});
const filters = [{ id: 'all', label: 'All' }, ...categoryDefinitions.filter(category => articles.some(article => article.categories.includes(category.id))).map(({ id, label }) => ({ id, label }))];
function formatDate(date: Date) {
  return date.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric', timeZone: 'UTC' });
}
---
<main id="main-content" class="writing-main studio-container">
  <header class="writing-header">
    <div class="writing-office" aria-hidden="true"><img src="/images/articles/writing-header.webp" width="1536" height="1030" alt="" fetchpriority="high" /></div>
    <div class="writing-header-copy">
      <p class="studio-eyebrow">{researchOnly ? 'The research notebook' : 'Writing & research'}</p>
      <h1 class="enter-title">Ideas, lessons, and<br />what I’m exploring.</h1>
      <p class="writing-lede">{researchOnly ? 'Landscape scans, tool comparisons, and working maps of AI, design, and agentic systems.' : 'Technical notes, architecture thinking, AI, product development, and lessons from real-world projects.'}</p>
    </div>
  </header>

  <section class="writing-collection" aria-label={researchOnly ? 'Published research' : 'Published writing and research'} data-writing-index>
    <div class="writing-controls">
      <div class="writing-filters" role="group" aria-label="Filter articles by topic">
        {filters.map(filter => <button type="button" data-writing-filter={filter.id} aria-pressed={filter.id === 'all'} aria-controls="writing-grid">{filter.label}</button>)}
      </div>
      <label class="writing-search"><span class="writing-sr-only">Search articles</span><input type="search" placeholder="Search articles…" data-writing-search aria-controls="writing-grid" autocomplete="off" /><Icon name="search" class="icon" /></label>
    </div>
    <div class="writing-results"><p aria-live="polite" aria-atomic="true" data-writing-status>{articles.length} articles</p><button type="button" data-writing-reset hidden>Clear filters <span aria-hidden="true">×</span></button></div>
    <div class="writing-grid enter-list" id="writing-grid" style="--enter-delay: 200ms">
      {articles.map((article, index) => <article class="writing-card" style={`--i: ${index}`} data-writing-card data-categories={article.categories.join(' ')} data-search={article.search}>
        <a href={article.href} class="writing-card-link">
          <div class="writing-card-image" transition:name={mediaTransitionName(article.href)}><img src={article.image} alt="" width="960" height="480" loading="lazy" decoding="async" /></div>
          <div class="writing-card-content"><span class="writing-card-kind">{article.kind}</span><h2>{article.title}</h2><div class="writing-card-bottom"><time datetime={article.date.toISOString().slice(0, 10)}>{formatDate(article.date)}</time><span class="studio-arrow" aria-hidden="true"><Icon name="arrow-right" class="icon" /></span></div></div>
        </a>
      </article>)}
    </div>
    <div class="writing-empty" data-writing-empty hidden><Icon name="search" class="icon" /><h2>No articles found.</h2><p>Try a different search or clear the filters to see everything.</p><button type="button" class="studio-button" data-writing-reset>Clear search & filters <Icon name="arrow-right" class="icon" /></button></div>
    {articles.length === 0 && <p class="writing-unpublished">New writing is on the way. In the meantime, <a href="/work">explore the work</a>.</p>}
  </section>
  <footer class="writing-note"><p>Research is developed with Claude under my direction. I review every piece before it’s published.</p><a href={researchOnly ? '/writing' : '/notes'} class="studio-text-link">{researchOnly ? 'All writing & research' : 'More from the lab notes'} <Icon name="arrow-right" class="icon" /></a></footer>
</main>

<script>
  function initWritingIndex() {
    const collection = document.querySelector<HTMLElement>('[data-writing-index]');
    if (!collection || collection.dataset.initialized) return;
    collection.dataset.initialized = 'true';
    const search = collection.querySelector<HTMLInputElement>('[data-writing-search]');
    const buttons = Array.from(collection.querySelectorAll<HTMLButtonElement>('[data-writing-filter]'));
    const cards = Array.from(collection.querySelectorAll<HTMLElement>('[data-writing-card]'));
    const resets = Array.from(collection.querySelectorAll<HTMLButtonElement>('[data-writing-reset]'));
    const status = collection.querySelector<HTMLElement>('[data-writing-status]');
    const empty = collection.querySelector<HTMLElement>('[data-writing-empty]');
    const grid = collection.querySelector<HTMLElement>('#writing-grid');
    let selected = 'all';
    function updateArticles() {
      const query = search?.value.trim().toLocaleLowerCase() ?? '';
      const terms = query.split(/\s+/).filter(Boolean);
      let count = 0;
      cards.forEach(card => {
        const matchesCategory = selected === 'all' || card.dataset.categories?.split(' ').includes(selected);
        const matchesSearch = terms.every(term => card.dataset.search?.includes(term));
        card.hidden = !(matchesCategory && matchesSearch);
        // A card that comes back into view replays its entrance; order it by the filtered list, not the full one.
        if (!card.hidden) card.style.setProperty('--i', String(count++));
      });
      buttons.forEach(button => button.setAttribute('aria-pressed', String(button.dataset.writingFilter === selected)));
      if (empty) empty.hidden = count > 0 || cards.length === 0;
      const reset = resets[0];
      if (reset) reset.hidden = selected === 'all' && !query;
      if (status) status.textContent = `${count} ${count === 1 ? 'article' : 'articles'}${selected === 'all' ? '' : ` in ${buttons.find(button => button.dataset.writingFilter === selected)?.textContent}`}${query ? ` matching “${search?.value.trim()}”` : ''}`;
    }
    // Once the reader is filtering, returning cards answer immediately instead of waiting out the page-load delay.
    collection.addEventListener('input', () => grid?.style.setProperty('--enter-delay', '0ms'), { capture: true });
    collection.addEventListener('click', () => grid?.style.setProperty('--enter-delay', '0ms'), { capture: true });
    buttons.forEach(button => button.addEventListener('click', () => {
      selected = button.dataset.writingFilter ?? 'all';
      updateArticles();
    }));
    search?.addEventListener('input', updateArticles);
    resets.forEach(button => button.addEventListener('click', () => {
      selected = 'all';
      if (search) search.value = '';
      updateArticles();
      search?.focus();
    }));
    updateArticles();
  }
  initWritingIndex();
  document.addEventListener('astro:page-load', initWritingIndex);
</script>

<style>
  .writing-main { padding-top: 34px; padding-bottom: 62px; }
  .writing-header { position: relative; isolation: isolate; min-height: 285px; display: flex; align-items: center; padding: 26px 0 34px; }
  .writing-header-copy { position: relative; z-index: 1; max-width: 670px; }
  .writing-header h1 { font: 300 clamp(40px, 4.4vw, 60px)/1.08 var(--headline); letter-spacing: -.01em; margin: 0 0 20px; }
  .writing-lede { color: var(--studio-muted); font-size: 15px; line-height: 1.7; font-weight: 400; max-width: 56ch; margin: 0; }
  .writing-office { position: absolute; z-index: -1; pointer-events: none; inset: -90px -48px -30px 35%; overflow: hidden; opacity: .65; mask-image: linear-gradient(to right, transparent, black 45%), linear-gradient(to bottom, transparent, black 15%, black 60%, transparent); mask-composite: intersect; }
  .writing-office img { width: 100%; height: 100%; object-fit: cover; object-position: center 45%; }
  .writing-controls { display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 20px; margin: 12px 0 14px; }
  .writing-filters { display: flex; align-items: center; flex-wrap: wrap; gap: 8px; }
  .writing-filters button { appearance: none; border: 1px solid var(--studio-rule); border-radius: 99px; background: var(--studio-surface); color: var(--studio-muted); padding: 9px 15px; font: 500 12px/1.4 var(--sans); cursor: pointer; transition: background 150ms, color 150ms, border-color 150ms; }
  .writing-filters button:hover { border-color: var(--studio-cyan); color: var(--studio-ink); }
  .writing-filters button[aria-pressed='true'] { background: var(--studio-ink); color: var(--studio-bg); border-color: var(--studio-ink); font-weight: 650; }
  .writing-search { display: flex; align-items: center; gap: 12px; padding: 10px 13px; border: 1px solid var(--studio-rule); border-radius: 7px; background: var(--studio-surface); min-width: 220px; width: 290px; transition: border-color 150ms; }
  .writing-search:focus-within { border-color: var(--studio-cyan); }
  .writing-search input { width: 100%; min-width: 0; padding: 0; border: none; border-radius: 0; background: transparent; color: var(--studio-ink); font: 400 12px/1.4 var(--sans); outline-offset: 7px; }
  .writing-search input::placeholder { color: var(--studio-muted); opacity: .85; }
  .writing-search .icon { width: 16px; height: 16px; color: var(--studio-muted); flex-shrink: 0; }
  .writing-sr-only { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; }
  .writing-results { min-height: 32px; display: flex; align-items: flex-start; justify-content: space-between; gap: 16px; color: var(--studio-muted); font-size: 10px; margin: 0 0 7px; }
  .writing-results p { margin: 0; line-height: 1.6; }
  .writing-results button { appearance: none; color: var(--studio-muted); background: none; border: 0; font: 500 10px/1.6 var(--sans); padding: 0; cursor: pointer; white-space: nowrap; }
  .writing-results button:hover { color: var(--studio-cyan); }
  .writing-results button span { font-size: 14px; margin-left: 6px; }
  .writing-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 22px; }
  .writing-card { min-width: 0; overflow: hidden; border: 1px solid var(--studio-rule); border-radius: 10px; background: var(--studio-surface); transition: transform 150ms, border-color 150ms; }
  .writing-card:hover, .writing-card:focus-within { border-color: var(--studio-cyan); transform: translateY(-2px); }
  .writing-card-link { display: flex; flex-direction: column; height: 100%; color: var(--studio-ink); text-decoration: none; border: none; }
  .writing-card-image { overflow: hidden; aspect-ratio: 2 / 1; background: var(--studio-raised); }
  .writing-card-image img { display: block; width: 100%; height: 100%; object-fit: cover; transition: transform 400ms; }
  .writing-card:hover img { transform: scale(1.025); }
  .writing-card-content { display: flex; flex-direction: column; flex: 1; padding: 17px 18px 16px; }
  .writing-card-kind { display: block; font-size: 9px; font-weight: 500; color: var(--studio-muted); margin: 0 0 10px; letter-spacing: .1em; text-transform: uppercase; }
  .writing-card h2 { font: 650 16px/1.5 var(--sans); letter-spacing: -.015em; margin: 0 0 18px; }
  .writing-card-bottom { display: flex; justify-content: space-between; align-items: center; gap: 12px; margin-top: auto; }
  .writing-card time { font: 400 10px/1.6 var(--sans); color: var(--studio-muted); }
  .writing-card .studio-arrow { width: 29px; height: 29px; }
  .writing-card .studio-arrow .icon { width: 16px; height: 16px; }
  .writing-empty { text-align: center; padding: 65px 20px; border: 1px solid var(--studio-rule); border-radius: 10px; background: var(--studio-surface); }
  .writing-empty > .icon { width: 25px; height: 25px; color: var(--studio-cyan); margin-bottom: 16px; }
  .writing-empty h2 { font: 650 24px/1.3 var(--sans); margin: 0 0 12px; }
  .writing-empty p { color: var(--studio-muted); font-size: 13px; line-height: 1.6; margin: 0 0 22px; }
  .writing-empty .studio-button { font-size: 12px; }
  .writing-unpublished { color: var(--studio-muted); padding: 30px 0; }
  .writing-note { display: flex; align-items: center; justify-content: space-between; gap: 36px; border-top: 1px solid var(--studio-rule); margin-top: 38px; padding-top: 24px; }
  .writing-note p { font-size: 11px; line-height: 1.75; color: var(--studio-muted); max-width: 66ch; margin: 0; }
  .writing-note a { white-space: nowrap; font-size: 11px; }
  :global(html[data-theme='light']) .writing-office { opacity: .2; }
  @media (min-width: 721px) and (max-width: 1000px) {
    .writing-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .writing-search { width: 240px; }
  }
  @media (max-width: 720px) {
    .writing-main { padding-top: 10px; padding-bottom: 40px; }
    .writing-header { min-height: 270px; padding: 25px 0 28px; }
    .writing-header h1 { font-size: clamp(30px, 7.8vw, 38px); line-height: 1.14; }
    .writing-lede { font-size: 13px; max-width: 39ch; }
    .writing-office { inset: -40px -20px 0 12%; opacity: .3; }
    .writing-controls { margin-top: 10px; gap: 16px; }
    .writing-filters { gap: 7px; }
    .writing-filters button { font-size: 11px; padding: 8px 12px; }
    .writing-search { width: 100%; }
    .writing-grid { grid-template-columns: 1fr; gap: 20px; }
    .writing-card h2 { font-size: 16px; }
    .writing-card-content { padding: 18px; }
    .writing-card-image { aspect-ratio: 2.1 / 1; }
    .writing-note { align-items: flex-start; flex-direction: column; gap: 12px; }
  }
  @media (prefers-reduced-motion: reduce) {
    .writing-card, .writing-card-image img, .writing-filters button, .writing-search { transition: none; }
    .writing-card:hover, .writing-card:focus-within, .writing-card:hover img { transform: none; }
  }
</style>
