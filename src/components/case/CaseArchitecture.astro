---
import Icon from '../Icon.astro';
import JobbyJobArchitecture from './JobbyJobArchitecture.astro';
import type { WorkPresentation } from '../../lib/work-presentation';

interface Props {
  slug: string;
  presentation: WorkPresentation;
  variant?: 'page' | 'chat';
}
const { slug, presentation, variant = 'page' } = Astro.props;
const chat = variant === 'chat';
const heading = 'Architecture';
const steps = presentation.architecture;
// JobbyJob's page shows the full system diagram in place of the four-card flow.
const diagram = !chat && slug === 'jobbyjob';
---
<section class:list={['case-architecture', { 'is-chat': chat }]} aria-labelledby={chat ? undefined : 'architecture-title'} aria-label={chat ? heading : undefined}>
  <div class="case-section-heading"><h2 id={chat ? undefined : 'architecture-title'}>{heading}</h2><span>A system, end to end</span></div>
  {diagram ? <JobbyJobArchitecture /> : <ol class="architecture-flow">
    {steps.map((step, index) => <li class={`architecture-step architecture-step-${index + 1}`}><span class="architecture-icon"><Icon name={step.icon} class="icon" /></span><h3>{step.title}</h3><ul>{step.items.map(item => <li>{item}</li>)}</ul>{index < steps.length - 1 && <span class="architecture-connector" aria-hidden="true"><Icon name="arrow-right" class="icon" /></span>}</li>)}
  </ol>}
</section>

<style>
  .case-architecture { margin-bottom: 56px; }
  .case-section-heading { display: flex; align-items: center; justify-content: space-between; gap: 20px; margin-bottom: 16px; }
  .case-section-heading h2 { font: 700 20px/1.3 var(--sans); letter-spacing: -.02em; margin: 0; }
  .case-section-heading > span { color: var(--studio-muted); font-size: 11px; }
  .architecture-flow { margin: 0; padding: 0; list-style: none; display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 30px; }
  .architecture-step { --step-accent: var(--studio-cyan); position: relative; border: 1px solid color-mix(in srgb, var(--step-accent) 65%, var(--studio-rule)); border-radius: 10px; background: var(--studio-surface); padding: 20px 15px; }
  .architecture-step-2 { --step-accent: var(--studio-cyan); }
  .architecture-step-3 { --step-accent: var(--studio-purple); }
  .architecture-step-4 { --step-accent: var(--studio-orange); }
  .architecture-icon { display: flex; align-items: center; justify-content: center; width: 35px; height: 35px; margin: 0 0 13px; border: 1px solid var(--studio-rule); background: var(--studio-raised); border-radius: 7px; color: var(--step-accent); }
  .architecture-icon .icon { width: 20px; height: 20px; }
  .architecture-step h3 { color: var(--step-accent); font: 650 12px/1.5 var(--sans); margin: 0 0 12px; }
  .architecture-step ul { padding: 0; list-style: none; display: grid; gap: 8px; }
  .architecture-step ul li { font: 400 11px/1.5 var(--sans); color: var(--studio-muted); }
  .architecture-connector { position: absolute; right: -26px; top: 50%; color: var(--studio-muted); }
  .architecture-connector .icon { width: 20px; height: 20px; }

  /* Four steps across need the full page. In a conversation the flow reads as
     a 2x2 grid in reading order, and on narrow columns as a numbered list where
     the icon sits beside its step instead of above it. The arrows only make
     sense in a single row, so they go. */
  .is-chat { margin: 0; container-type: inline-size; }
  .is-chat .case-section-heading { margin-bottom: 12px; }
  .is-chat .case-section-heading h2 { font-size: 16px; }
  .is-chat .architecture-flow { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 12px; }
  .is-chat .architecture-step { padding: 16px 14px; }
  .is-chat .architecture-icon { width: 30px; height: 30px; margin-bottom: 10px; }
  .is-chat .architecture-icon .icon { width: 17px; height: 17px; }
  .is-chat .architecture-step h3 { margin-bottom: 8px; }
  .is-chat .architecture-step ul { margin: 0; gap: 5px; }
  .is-chat .architecture-connector { display: none; }
  @container (max-width: 420px) {
    .is-chat .case-section-heading > span { display: none; }
    .is-chat .architecture-flow { grid-template-columns: 1fr; gap: 8px; }
    .is-chat .architecture-step { display: grid; grid-template-columns: 30px 1fr; column-gap: 12px; padding: 14px; }
    .is-chat .architecture-icon { grid-row: span 2; margin: 0; }
    .is-chat .architecture-step h3 { margin-bottom: 6px; }
  }
  @media (max-width: 900px) and (min-width: 721px) {
    .case-architecture:not(.is-chat) .architecture-flow { gap: 22px; }
    .case-architecture:not(.is-chat) .architecture-step { padding: 16px 12px; }
    .case-architecture:not(.is-chat) .architecture-connector { right: -22px; }
  }
  @media (max-width: 720px) {
    .case-architecture:not(.is-chat) .case-section-heading > span { display: none; }
    .case-architecture:not(.is-chat) .architecture-flow { grid-template-columns: 1fr 1fr; gap: 16px; }
    .case-architecture:not(.is-chat) .architecture-step { padding: 18px 14px; }
    .case-architecture:not(.is-chat) .architecture-connector { display: none; }
    .architecture-step h3 { font-size: 12px; }
    .case-architecture:not(.is-chat) .architecture-step ul li { font-size: 10px; }
  }
</style>
