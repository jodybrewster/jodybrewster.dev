<script>
  import { track } from '../../lib/track';
  // Delegated at the document so it survives ClientRouter soft navigations; the
  // dialog is looked up per click because each page swap replaces it.
  let opener: HTMLElement | null = null;

  document.addEventListener('click', (event) => {
    const button = (event.target as Element | null)?.closest<HTMLElement>('.jj-preview');
    if (button) {
      const dialog = document.querySelector<HTMLDialogElement>('dialog.jj-dialog');
      if (!dialog) return;
      opener = button;
      dialog.querySelector('.jj-dialog-view')?.scrollTo(0, 0);
      dialog.showModal();
      track('diagram_open', { page: location.pathname });
      return;
    }
    // A click on the backdrop lands on the dialog element itself.
    const target = event.target;
    if (target instanceof HTMLDialogElement && target.classList.contains('jj-dialog')) target.close();
  });

  // close does not bubble, so listen in the capture phase.
  document.addEventListener('close', (event) => {
    if (!(event.target instanceof HTMLDialogElement) || !event.target.classList.contains('jj-dialog')) return;
    if (opener?.isConnected) opener.focus();
    opener = null;
  }, true);
</script>

<style is:global>
  html:has(dialog.jj-dialog[open]) { overflow: hidden; }
</style>

<style>
  .jj-arch { margin: 0; }
  .jj-preview { position: relative; display: block; width: 100%; height: 300px; padding: 0; overflow: hidden; border: 1px solid var(--studio-rule); border-radius: 10px; background: var(--studio-bg); color: inherit; font: inherit; text-align: left; cursor: zoom-in; transition: border-color 160ms ease-out; }
  .jj-preview:hover { border-color: var(--studio-cyan); }
  .jj-preview:focus-visible { outline: 2px solid var(--studio-cyan); outline-offset: 3px; border-color: var(--studio-cyan); }
  /* Full scale, cropped to the pipeline and the operator row: readable, not shrunk. */
  .jj-preview-canvas { position: absolute; left: 16px; top: -100px; width: 1400px; pointer-events: none; }
  .jj-preview-canvas svg { display: block; width: 1400px; height: auto; }
  .jj-preview::after { content: ''; position: absolute; inset: auto 0 0 0; height: 84px; background: linear-gradient(to bottom, color-mix(in srgb, var(--studio-bg) 0%, transparent), var(--studio-bg) 88%); pointer-events: none; }
  .jj-preview-pill { position: absolute; left: 50%; bottom: 18px; z-index: 1; transform: translateX(-50%); display: inline-flex; align-items: center; gap: 7px; font: 600 11px/1 var(--sans); color: var(--studio-ink); background: var(--studio-bg); border: 1px solid var(--studio-rule); border-radius: 99px; padding: 10px 16px; white-space: nowrap; transition: border-color 160ms ease-out, color 160ms ease-out; }
  .jj-expand { width: 14px; height: 14px; }
  .jj-preview:hover .jj-preview-pill, .jj-preview:focus-visible .jj-preview-pill { border-color: var(--studio-cyan); color: var(--studio-cyan); }
  .jj-arch figcaption { margin-top: 12px; color: var(--studio-muted); font: 400 12px/1.6 var(--sans); max-width: 90ch; }

  /* Matches ImageLightbox: full-viewport dialog, dim backdrop, Close pill, 180ms scale-in. */
  .jj-dialog { max-width: none; max-height: none; width: 100%; height: 100%; margin: 0; padding: 16px; border: 0; background: transparent; display: none; flex-direction: column; align-items: center; justify-content: center; gap: 12px; cursor: zoom-out; }
  .jj-dialog[open] { display: flex; animation: jj-dialog-in 180ms ease-out; }
  .jj-dialog::backdrop { background: color-mix(in srgb, var(--studio-bg) 96%, transparent); }
  .jj-dialog-bar { width: 100%; max-width: 1600px; display: flex; justify-content: flex-end; }
  .jj-dialog-close { font: 600 11px/1 var(--sans); color: var(--studio-ink); background: var(--studio-bg); border: 1px solid var(--studio-rule); border-radius: 99px; padding: 11px 17px; cursor: pointer; }
  .jj-dialog-close:hover { border-color: var(--studio-cyan); color: var(--studio-cyan); }
  .jj-dialog-view { width: min(100%, 1600px); max-height: calc(100% - 52px); overflow: auto; overscroll-behavior: contain; padding: 20px; border: 1px solid var(--studio-rule); border-radius: 10px; background: var(--studio-bg); cursor: default; }
  .jj-dialog-view:focus-visible { outline: 2px solid var(--studio-cyan); outline-offset: 2px; }
  /* Fit to width, but never below 1000px: narrower screens scroll sideways instead. */
  .jj-dialog-view svg { display: block; width: 100%; min-width: 1000px; height: auto; }
  @keyframes jj-dialog-in { from { opacity: 0; transform: scale(.98); } }
  @media (prefers-reduced-motion: reduce) { .jj-dialog[open] { animation: none; } .jj-preview, .jj-preview-pill { transition: none; } }
  @media (max-width: 720px) {
    .jj-dialog { padding: 12px; }
    .jj-dialog-view { padding: 12px; }
  }
</style>
