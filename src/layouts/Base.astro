---
import { scriptJson } from '../lib/script-json';
import '../styles/global.css';
import '../styles/chat-mobile.css';
import { ClientRouter } from 'astro:transitions';
import IconSprite from '../components/IconSprite.astro';
import Nav from '../components/Nav.astro';
import HomeNav from '../components/HomeNav.astro';
import Footer from '../components/Footer.astro';
import ChatDock from '../components/ChatDock.astro';
import Analytics from '../components/Analytics.astro';
import { chatBuilt } from '../lib/switches';

interface Props {
  title: string;
  description?: string;
  jsonLd?: Record<string, unknown>;
  markdownHref?: string;
  bodyClass?: string;
  home?: boolean;
}

const { title, description, jsonLd, markdownHref, bodyClass, home = false } = Astro.props;
// SWITCH_CHAT, read when the page is built: anything but on builds no dock.
const chat = chatBuilt();
---
<!doctype html>
<html lang="en" data-theme="dark">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
  <meta name="color-scheme" content="dark" />
  <title>{title}</title>
  <!-- Dark is a permanent design choice, including across client-side navigation. -->
  {description && <meta name="description" content={description} />}

  <link rel="icon" type="image/png" href="/favicon.png" />

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <!-- Headlines: Barlow Semi Condensed. Body/UI: Plus Jakarta Sans. Legacy editorial: Source Serif 4. Mono: JetBrains Mono. -->
  <link href="https://fonts.googleapis.com/css2?family=Barlow+Semi+Condensed:wght@300;400;500&family=Source+Serif+4:ital,opsz,wght@0,8..60,200..900;1,8..60,200..900&family=Plus+Jakarta+Sans:ital,wght@0,200..800;1,200..800&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet">

  {markdownHref && (
    <link rel="alternate" type="text/markdown" href={markdownHref} />
  )}

  {jsonLd && (
    <script is:inline type="application/ld+json" set:html={scriptJson(jsonLd)} />
  )}

  <Analytics />

  <ClientRouter />
</head>
<body class={bodyClass} data-chat-enabled={chat ? '' : undefined}>
  <IconSprite />
  <div class="shell">
    {home ? <HomeNav /> : <Nav />}
    <slot />
    <Footer />
  </div>
  {chat && <ChatDock />}
  <script>
    // Pages reached by an in-site navigation are marked, so entrances that the page change already covers
    // (a lead image that travels in from its card, the full home intro) can step aside. A full load clears it.
    document.addEventListener('astro:before-swap', event => {
      event.newDocument.documentElement.dataset.softNav = '';
    });
  </script>
</body>
</html>
