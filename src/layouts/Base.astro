---
import '../styles/global.css';
import { ClientRouter } from 'astro:transitions';
import IconSprite from '../components/IconSprite.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import ChatDock from '../components/ChatDock.astro';
import Analytics from '../components/Analytics.astro';
import { flags } from '../lib/flags';

interface Props {
  title: string;
  description?: string;
  jsonLd?: Record<string, unknown>;
  markdownHref?: string;
  bodyClass?: string;
}

const { title, description, jsonLd, markdownHref, bodyClass } = Astro.props;
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="color-scheme" content="light dark" />
  <title>{title}</title>
  <!--
    Anti-FOUC: apply the theme before first paint. This script owns the theme
    outright, rather than sharing it with a component, because it is the only
    place that can: ClientRouter rebuilds <html>'s attributes from the incoming
    document on every navigation, and the incoming document has no data-theme.
    Being identical on every page, this script is carried across a swap instead
    of re-running, so the listeners below survive with it.

    Dark is the default and the OS preference is deliberately not consulted:
    the site has a look, and a visitor on a light desktop should still see it.
    A stored choice always wins, so anyone who picks light keeps light.
  -->
  <script is:inline>
    (function () {
      function apply() {
        document.documentElement.setAttribute(
          'data-theme',
          localStorage.getItem('theme') === 'light' ? 'light' : 'dark'
        );
      }

      apply();

      // The swap strips data-theme off <html>. Put it back the moment the new
      // document is in place, before it paints.
      document.addEventListener('astro:after-swap', apply);

      // Delegated: the swap replaces the button and takes any listener bound to
      // it, which left the toggle dead after the first navigation. The document
      // outlives every swap.
      document.addEventListener('click', function (e) {
        if (!(e.target instanceof Element) || !e.target.closest('#theme-toggle')) return;
        var current = localStorage.getItem('theme') === 'light' ? 'light' : 'dark';
        localStorage.setItem('theme', current === 'dark' ? 'light' : 'dark');
        apply();
      });
    })();
  </script>
  {description && <meta name="description" content={description} />}

  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <!-- Display: Source Serif 4 (editorial serif w/ optical sizing). Body/UI: Plus Jakarta Sans. Mono: JetBrains Mono. -->
  <link href="https://fonts.googleapis.com/css2?family=Source+Serif+4:ital,opsz,wght@0,8..60,200..900;1,8..60,200..900&family=Plus+Jakarta+Sans:ital,wght@0,200..800;1,200..800&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet">

  {markdownHref && (
    <link rel="alternate" type="text/markdown" href={markdownHref} />
  )}

  {jsonLd && (
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  )}

  <Analytics />

  <ClientRouter />
</head>
<body class={bodyClass}>
  <IconSprite />
  <div class="shell">
    <Nav />
    <slot />
    <Footer />
  </div>
  {flags.chat && <ChatDock />}
</body>
</html>
