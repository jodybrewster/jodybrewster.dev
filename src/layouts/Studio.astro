---
import Base from './Base.astro';
import '../styles/studio.css';
interface Props {
  title: string;
  description?: string;
  jsonLd?: Record<string, unknown>;
  markdownHref?: string;
  bodyClass?: string;
}
const {bodyClass = '', ...props} = Astro.props;
---
<Base {...props} bodyClass={`studio-page ${bodyClass}`} home>
  <slot />
</Base>
