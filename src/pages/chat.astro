---
import Base from '../layouts/Base.astro';
import PageHeader from '../components/PageHeader.astro';
import { flags } from '../lib/flags';

if (!flags.chat) return Astro.redirect('/');
---
<Base
  title="Verso — Jody Brewster"
  description="Verso is the chat on Jody Brewster's site. It answers from his published essays, notes, and case briefs, cites what it drew on, and refuses what isn't in the writing."
>
  <main class="page active" style="padding: 72px 0 100px;">
    <PageHeader
      icon="i-chat"
      eyebrow="Verso"
      title="Verso."
      description="Ask about anything published here. Verso answers from the writing, shows you what it drew on, and tells you plainly when the writing doesn't cover it."
    />

    <div class="chat-explainer">
      <p>A verso is the left-hand page of an open book: the one you have already read, facing the one you are reading now. Verso answers from what Jody has published, speaks <em>about</em> him rather than <em>as</em> him, cites the pieces it drew on, and refuses what the writing doesn't cover. It will sometimes be wrong, so the cited piece is the source of truth, not the synthesis above it.</p>
      <p>The ask bar at the bottom of every page is Verso. Type a question anywhere on the site. An answer can take a moment, and Jody reads everything people ask it.</p>
    </div>
  </main>
</Base>

<style>
  .chat-explainer {
    max-width: 62ch;
  }
  .chat-explainer p {
    font-family: var(--sans);
    font-size: 16.5px;
    line-height: 1.7;
    color: var(--ink-soft);
    margin: 0 0 18px;
  }
  .chat-explainer em {
    font-family: var(--display);
    font-style: italic;
    font-variation-settings: "opsz" 14;
    color: var(--ink);
  }
</style>
