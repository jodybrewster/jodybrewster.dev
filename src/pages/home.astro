---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import HomeCaseStudies from '../components/HomeCaseStudies.astro';
import '../styles/home.css';

const research = (await getCollection('research', r => r.data.publish))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()).slice(0, 3);
const capabilities = [
  { icon: 'code', title: 'AI & Agents', description: 'Design · Build · Evaluate', color: 'orange' },
  { icon: 'cube', title: 'Web & Mobile', description: 'Modern apps, end to end', color: 'cyan' },
  { icon: 'database', title: 'Data & Integrations', description: 'APIs · Azure · GCP · Databases', color: 'purple' },
  { icon: 'zap', title: 'Real-World Impact', description: 'From prototype to production', color: 'pink' },
];
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: 'Jody Brewster',
  url: 'https://jodybrewster.dev/',
  jobTitle: 'AI Engineer',
  sameAs: ['https://github.com/jodybrewster', 'https://www.linkedin.com/in/jodybrewster', 'https://www.behance.net/jodybrewster'],
  knowsAbout: ['AI engineering', 'Agentic systems', 'Product development', 'Web and mobile applications', 'Data platforms'],
};
---
<Base title="Jody Brewster · AI Engineering & Product Development" description="I build and ship AI-powered products: intelligent chat experiences, agents, and web and mobile applications that people use." bodyClass="home-page" home jsonLd={jsonLd}>
  <div class="home-backdrop" aria-hidden="true">
    <img src="/images/home/jody-office.webp" srcset="/images/home/jody-office-1080.webp 1080w, /images/home/jody-office.webp 2160w" sizes="100vw" width="2160" height="720" alt="" fetchpriority="high" />
    <div class="face-gag" hidden>
      <div class="face-gag-sign">
        <div class="face-gag-float">
          <svg class="face-gag-arrow" viewBox="0 0 96 64" width="96" height="64"><path d="M92 60C70 58 38 46 8 8" /><path d="M6 23L8 8l14 6" /></svg>
          <p class="face-gag-card">My son said the AI looks better! lol</p>
        </div>
      </div>
    </div>
    <script is:inline data-astro-rerun>
      try {
        if (!sessionStorage.getItem('home:face-gag') && Math.random() < 0.2) {
          sessionStorage.setItem('home:face-gag', '1');
          document.querySelector('.face-gag').hidden = false;
        }
      } catch {}
    </script>
  </div>
  <main id="main-content" class="home-main">
    <section class="home-hero home-container" aria-labelledby="home-title">
      <div class="hero-copy">
        <p class="home-eyebrow hero-eyebrow">AI Engineering & Product Development</p>
        <h1 id="home-title" aria-label="I build and ship AI-powered products."><span class="hero-word" style="--w: 0"><span>I</span></span> <span class="hero-word" style="--w: 1"><span>build</span></span> <span class="hero-word" style="--w: 2"><span>and</span></span> <span class="hero-word" style="--w: 3"><span>ship</span></span><br /> <span class="hero-word" style="--w: 4"><span>AI-powered</span></span><br /> <span class="hero-word hero-word-accent" style="--w: 5"><span class="text-gradient">products.</span></span></h1>
        <p class="hero-description">From intelligent chat experiences to scalable web and mobile applications, I turn ideas into real products that people use.</p>
        <div class="hero-actions">
          <a href="#featured-work" class="home-button home-button-primary">View Featured Work <Icon name="arrow-right" class="icon" /></a>
          <a href="/jodybrewster_resume_2026.pdf" download class="home-button">Download Résumé <Icon name="file" class="icon" /></a>
        </div>
      </div>
    </section>

    <section class="capabilities-section" aria-labelledby="capabilities-title">
      <div class="home-container">
        <h2 class="visually-hidden" id="capabilities-title">What I build</h2>
        <div class="capability-grid">
          {capabilities.map(item => (
            <div class={`capability capability-${item.color}`}>
              <span class="capability-icon" aria-hidden="true">
                <Icon name={item.icon} class="icon" />
              </span>
              <div><h3>{item.title}</h3><p>{item.description}</p></div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <section class="experience-strip home-container" aria-label="Trusted experience">
      <div class="experience-brands">
        <h2 class="home-eyebrow">Trusted experience</h2>
        <ul class="brand-list" aria-label="Companies I've worked with">
          <li class="brand-lennar"><span class="brand-logo" role="img" aria-label="Lennar"></span></li>
          <li class="brand-carnival"><span class="brand-logo" role="img" aria-label="Carnival Cruise Line"></span></li>
          <li class="brand-disney"><span class="brand-logo" role="img" aria-label="Disney"></span></li>
          <li class="brand-gm"><span class="brand-logo" role="img" aria-label="General Motors"></span></li>
        </ul>
      </div>
      <dl class="experience-facts">
        <div><dt>15+</dt><dd>Years Experience</dd></div>
        <div><dt>AI</dt><dd>Products & Platforms</dd></div>
        <div><dt>Enterprise</dt><dd>Web & Data Systems</dd></div>
      </dl>
    </section>

    <HomeCaseStudies />


    <section class="home-notebook home-container" aria-labelledby="notebook-title">
      <div class="notebook-heading"><div><p class="home-eyebrow">Beyond the build</p><h2 id="notebook-title">A look inside the notebook.</h2></div><a href="/research" class="home-text-link">All research <Icon name="arrow-right" class="icon" /></a></div>
      <div class="notebook-grid">
        {research.map(entry => <a href={`/research/${entry.id}`} class="notebook-entry"><span class="home-eyebrow">Research · {entry.data.pubDate.toLocaleDateString('en-US', { month: 'short', year: 'numeric', timeZone: 'UTC' })}</span><h3>{entry.data.title}</h3><span class="notebook-read">Read the research <Icon name="arrow-right" class="icon" /></span></a>)}
      </div>
      <div class="notebook-links"><a href="/notes">Lab notes <Icon name="arrow-right" class="icon" /></a><a href="/now">What I'm working on <Icon name="arrow-right" class="icon" /></a><a href="/library" data-astro-reload>Explore my library <Icon name="arrow-right" class="icon" /></a><a href="/portfolio">More interface work <Icon name="arrow-right" class="icon" /></a></div>
    </section>
  </main>
</Base>

