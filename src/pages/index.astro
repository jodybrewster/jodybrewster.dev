---
/**
 * / - the shelf, and the site's front door.
 *
 * A separate surface from the rest of the site, which lives under /home: full
 * bleed, no global nav or footer chrome. The data comes from the shared payload
 * builder, so this page and the /library-data.json endpoint that warms the
 * scene never diverge.
 */
import LibraryShelf from '../components/LibraryShelf.astro';
import { buildShelfPayload } from '../lib/shelf/payload';
import '../styles/global.css';
import '../styles/shelf.css';

const { albums, books, notebooks, listeningLabel, libraryLabel, notebookLabel, siteNotebookId } =
  await buildShelfPayload();

const title = 'Library - Jody Brewster';
const description =
  `A shelf of what Jody Brewster is reading and listening to: ${books.length} books, `
  + `${albums.length} albums in rotation, and recent notebooks from the site.`;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: 'Library',
  url: 'https://jodybrewster.dev/',
  description,
  isPartOf: { '@type': 'WebSite', url: 'https://jodybrewster.dev/' },
};
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="color-scheme" content="light" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link
    href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght,SOFT@0,9..144,300..600,30..100;1,9..144,300..600,30..100&family=Inter:wght@400;500;600&family=JetBrains+Mono:wght@400;500&display=swap"
    rel="stylesheet"
  />

  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

  <script is:inline>
    // On anything getting the 3D shelf, the server-rendered one is not a
    // loading state - it is a different design, and showing it first means
    // arriving at flat colour blocks that are then replaced. Hold it back and
    // let the plaster stand until the scene draws. The timeout is the safety
    // net for a scene that never arrives.
    (function () {
      try {
        var el = document.documentElement;
        el.setAttribute('data-shelf-pending', 'true');
        setTimeout(function () { el.removeAttribute('data-shelf-pending'); }, 8000);
      } catch (error) {
        /* fall through to the semantic shelf */
      }
    })();
  </script>
</head>
<body class="library-page">
  <main>
    <h1 class="library__h1">Library</h1>
    <LibraryShelf
      albums={albums}
      books={books}
      notebooks={notebooks}
      listeningLabel={listeningLabel}
      libraryLabel={libraryLabel}
      notebookLabel={notebookLabel}
      siteNotebookId={siteNotebookId}
    />
  </main>
</body>
</html>
