---
/**
 * /library - where Jody has been, what he reads, watches, plays and listens
 * to, and what he works in, floating in one room. The data comes from the shared payload builder, so this page and
 * the /library-data.json endpoint never diverge.
 */
import Studio from '../layouts/Studio.astro';
import LibraryShelf from '../components/LibraryShelf.astro';
import { buildShelfPayload } from '../lib/shelf/payload';
import '../styles/shelf.css';

const payload = await buildShelfPayload();
const { albums, books, games } = payload;

const title = 'Library - Jody Brewster';
const description = `Where Jody Brewster has been, and what he reads, listens to, watches and plays: `
  + `${books.length} books, ${albums.length} albums in rotation`
  + `${games.length ? `, ${games.length} games` : ''} and the tools he works in.`;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: 'Library',
  url: 'https://jodybrewster.dev/library',
  description,
  isPartOf: { '@type': 'WebSite', url: 'https://jodybrewster.dev/' },
};
---
<Studio title={title} description={description} jsonLd={jsonLd} bodyClass="library-page">
  <main id="main-content">
    <h1 class="library__h1">Library</h1>
    <LibraryShelf payload={payload} />
  </main>
</Studio>
