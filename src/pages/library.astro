---
/**
 * /library - everything Jody reads, plays, listens to and writes, floating in
 * one room. The data comes from the shared payload builder, so this page and
 * the /library-data.json endpoint never diverge.
 */
import Studio from '../layouts/Studio.astro';
import LibraryShelf from '../components/LibraryShelf.astro';
import { buildShelfPayload } from '../lib/shelf/payload';
import '../styles/shelf.css';

const payload = await buildShelfPayload();
const { albums, books, games, articles, cases } = payload;

const title = 'Library - Jody Brewster';
const description = `What Jody Brewster is reading, playing, listening to and writing: ${books.length} books, `
  + `${albums.length} albums in rotation${games.length ? ', the games he played this month' : ''}, `
  + `${articles.length} pieces of writing and ${cases.length} case studies.`;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: 'Library',
  url: 'https://jodybrewster.dev/library',
  description,
  isPartOf: { '@type': 'WebSite', url: 'https://jodybrewster.dev/' },
};
---
<Studio title={title} description={description} jsonLd={jsonLd} bodyClass="library-page">
  <main id="main-content">
    <h1 class="library__h1">Library</h1>
    <LibraryShelf payload={payload} />
  </main>
</Studio>
