---
import { getCollection } from 'astro:content';
import Studio from '../../layouts/Studio.astro';
import PageHeader from '../../components/PageHeader.astro';
import PreAIBadge from '../../components/PreAIBadge.astro';

const projects = (await getCollection('portfolio'))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

// Work that no longer exists anywhere to show, kept by hand.
const lost = [
  'Toyota Matrix',
  'Fiat Abarth driving simulator site',
  "Coca-Cola's YouTube and FIFA World Cup site",
  'Guinness',
  "Smiley's",
  "Coca-Cola's Celebration sites",
  'Vitaminwater',
];

function formatDate(d: Date) {
  return d.toLocaleDateString('en-US', { month: 'short', year: 'numeric', timeZone: 'UTC' });
}
---
<Studio title="Portfolio — Jody Brewster" description="Selected interface and product design work — portals, mobile apps, mapping tools, and design systems.">
  <main class="page active studio-container" style="padding: 72px 0 100px;">
    <PageHeader
      icon="i-layers"
      eyebrow={`${projects.length} ${projects.length === 1 ? 'project' : 'projects'}`}
      title="Portfolio"
      description="Interface and product design work. Portals, mobile apps, mapping tools, and design systems. Currently, most of this is a small, recent sample of design work I've done before AI."
    >
      <p class="page-meta-link">Also on <a href="https://www.behance.net/jodybrewster" rel="me">Behance</a>.</p>
    </PageHeader>

    <ul class="folio-list">
      {projects.map(p => (
        <li>
          <a href={`/portfolio/${p.id}`}>
            <span class="thumb">
              <img src={p.data.cover} alt="" loading="lazy" />
            </span>
            <span class="body">
              <span class="badge"><PreAIBadge /></span>
              <span class="title">{p.data.title}</span>
              <span class="dek">{p.data.description}</span>
              <span class="meta">
                {formatDate(p.data.date)}
                {p.data.tags.length > 0 && <span class="tags"> · {p.data.tags.slice(0, 3).join(' · ')}</span>}
              </span>
            </span>
          </a>
        </li>
      ))}
    </ul>

    <section class="lost" aria-labelledby="lost-title">
      <h2 id="lost-title">Lost over the years</h2>
      <p>A lot of my work has been lost over the years. Some of what's gone:</p>
      <ul>
        {lost.map(name => <li>{name}</li>)}
        <li class="more">and more</li>
      </ul>
    </section>
  </main>
</Studio>

<style>
  .folio-list {
    list-style: none;
    padding: 0;
    margin: 0 0 100px;
  }
  .folio-list li {
    border-bottom: 1px solid var(--rule);
  }
  .folio-list a {
    display: grid;
    grid-template-columns: 220px 1fr;
    gap: 28px;
    align-items: start;
    padding: 28px 22px;
    margin: 0 -22px;
    border: none;
    border-radius: 6px;
    transition: background-color .2s ease;
  }
  .folio-list a:hover {
    background: var(--paper-warm);
  }
  .title { transition: color .2s ease; }
  .thumb {
    display: block;
    overflow: hidden;
    border: 1px solid var(--rule);
    border-radius: 4px;
    background: var(--paper-warm);
  }
  .thumb img {
    display: block;
    width: 100%;
    aspect-ratio: 16 / 10;
    object-fit: cover;
    object-position: top;
  }
  .body {
    display: block;
  }
  .badge {
    display: block;
    margin-bottom: 10px;
  }
  .title {
    display: block;
    font-family: var(--display);
    font-weight: 450;
    font-variation-settings: "opsz" 30;
    font-size: 25px;
    line-height: 1.2;
    letter-spacing: -0.012em;
    color: var(--ink);
    margin-bottom: 8px;
  }
  .folio-list a:hover .title {
    color: var(--accent);
  }
  .dek {
    display: block;
    font-family: var(--sans);
    font-size: 15px;
    line-height: 1.55;
    color: var(--ink-soft);
    max-width: 64ch;
    margin-bottom: 12px;
  }
  .meta {
    display: block;
    font-family: var(--mono);
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--ink-faint);
  }
  .lost {
    max-width: 64ch;
    margin: -40px 0 0;
  }
  .lost h2 {
    margin: 0 0 12px;
    font-family: var(--mono);
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--ink-faint);
  }
  .lost p {
    margin: 0 0 14px;
    font-family: var(--sans);
    font-size: 15px;
    line-height: 1.55;
    color: var(--ink-soft);
  }
  .lost ul {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .lost li {
    padding: 4px 11px;
    border: 1px solid var(--rule);
    border-radius: 99px;
    font-family: var(--sans);
    font-size: 13px;
    color: var(--ink-soft);
  }
  .lost li.more {
    border-color: transparent;
    padding-inline: 2px;
    color: var(--ink-faint);
  }
  @media (max-width: 720px) {
    .folio-list a {
      grid-template-columns: 1fr;
      gap: 16px;
    }
  }
</style>
