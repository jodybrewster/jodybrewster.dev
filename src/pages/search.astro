---
import Studio from '../layouts/Studio.astro';
---
<Studio title="Search — Jody Brewster" description="Search across Jody Brewster's writing, research, notes, and work.">
  <main class="page active search-main studio-container" aria-labelledby="search-title">
    <header class="search-header">
      <p class="studio-eyebrow">Find something specific</p>
      <h1 id="search-title" class="enter-title">Search the work.</h1>
      <p>Look across case studies, essays, research, and lab notes.</p>
    </header>

    <section class="search-panel" aria-label="Site search">
      <div id="search"></div>
      <p id="search-fallback" class="search-fallback" hidden>
        Search index is only generated by the production build. Run <code>npm run build &amp;&amp; npm run preview</code> to try it locally.
      </p>
    </section>
  </main>

  <link href="/pagefind/pagefind-ui.css" rel="stylesheet" />
  <script src="/pagefind/pagefind-ui.js" is:inline></script>
  <script is:inline>
    function initSearch() {
      const root = document.getElementById('search');
      const fallback = document.getElementById('search-fallback');
      if (!root || root.dataset.initialized) return;
      if (window.PagefindUI) {
        root.dataset.initialized = 'true';
        new window.PagefindUI({
          element: '#search',
          showSubResults: true,
          showImages: false,
          resetStyles: false,
          excerptLength: 30,
          processTerm: (term) => term.toLowerCase(),
        });
      } else {
        if (fallback) fallback.hidden = false;
      }
    }
    initSearch();
    document.addEventListener('astro:page-load', initSearch);
  </script>

  <style is:global>
    .search-main { padding-top: 52px; padding-bottom: 100px; }
    .search-header { max-width: 760px; padding: 28px 0 42px; }
    .search-header h1 { margin: 0 0 17px; font: 300 clamp(44px, 5.5vw, 70px)/1.04 var(--headline); letter-spacing: -.02em; }
    .search-header > p:last-child { max-width: 48ch; margin: 0; color: var(--studio-muted); font-size: 16px; line-height: 1.7; }
    .search-panel { max-width: 860px; min-height: 360px; padding: 24px; border: 1px solid var(--studio-rule); border-radius: 14px; background: var(--studio-surface); }
    .search-fallback { margin: 18px 0 0; color: var(--studio-muted); font-size: 13px; line-height: 1.7; }
    .search-fallback code { color: var(--studio-ink); }
    .pagefind-ui {
      --pagefind-ui-primary: var(--studio-cyan);
      --pagefind-ui-text: var(--studio-ink);
      --pagefind-ui-background: var(--studio-bg);
      --pagefind-ui-border: var(--studio-rule);
      --pagefind-ui-tag: var(--studio-raised);
      --pagefind-ui-border-width: 1px;
      --pagefind-ui-border-radius: 9px;
      --pagefind-ui-font: var(--sans);
    }
    .pagefind-ui .pagefind-ui__search-input {
      min-height: 58px;
      background: var(--studio-bg);
      color: var(--studio-ink);
      border-color: var(--studio-rule);
      font-family: var(--sans);
      font-size: 16px;
      transition: border-color 180ms var(--ease-out), box-shadow 180ms var(--ease-out);
    }
    .pagefind-ui .pagefind-ui__search-input:focus {
      border-color: var(--studio-cyan);
      outline: none;
      box-shadow: 0 0 0 3px color-mix(in srgb, var(--studio-cyan) 16%, transparent);
    }
    .pagefind-ui .pagefind-ui__search-clear { color: var(--studio-muted); }
    .pagefind-ui .pagefind-ui__results { margin-top: 24px; }
    .pagefind-ui .pagefind-ui__result { padding: 22px 0; border-top-color: var(--studio-rule); animation: search-result-in 240ms var(--ease-out) both; }
    .pagefind-ui .pagefind-ui__result-title a {
      color: var(--studio-ink);
      border-bottom: none;
      font-family: var(--sans);
      font-weight: 650;
    }
    .pagefind-ui .pagefind-ui__result-title a:hover { color: var(--studio-cyan); }
    .pagefind-ui .pagefind-ui__result-excerpt { color: var(--studio-muted); line-height: 1.7; }
    .pagefind-ui mark {
      background: var(--studio-raised);
      color: var(--studio-cyan);
      padding: 0 2px;
      border-radius: 2px;
    }
    .pagefind-ui .pagefind-ui__message { color: var(--studio-muted); font-size: 12px; }
    @keyframes search-result-in { from { opacity: 0; transform: translateY(8px); } }
    @media (max-width: 720px) {
      .search-main { padding-top: 20px; padding-bottom: 64px; }
      .search-header { padding: 20px 0 30px; }
      .search-header h1 { font-size: 40px; }
      .search-header > p:last-child { font-size: 14px; }
      .search-panel { min-height: 300px; padding: 14px; border-radius: 11px; }
    }
    @media (prefers-reduced-motion: reduce) {
      .pagefind-ui .pagefind-ui__result { animation: search-result-fade 150ms ease both !important; }
      @keyframes search-result-fade { from { opacity: 0; } }
    }
  </style>
</Studio>
