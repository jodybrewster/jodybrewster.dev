---
import { getCollection, getEntry, render } from 'astro:content';
import Studio from '../../layouts/Studio.astro';
import Icon from '../../components/Icon.astro';
import WorkEvaluationPreview from '../../components/WorkEvaluationPreview.astro';
import { workPresentation } from '../../lib/work-presentation';

export async function getStaticPaths() {
  const published = await getCollection('work', b => !b.data.draft);
  return published.map((entry) => ({ params: { slug: entry.id } }));
}

const { slug } = Astro.params;
const entry = slug ? await getEntry('work', slug) : undefined;
if (!entry || entry.data.draft) return new Response('Not found', { status: 404 });
const presentation = workPresentation[entry.id];
const title = presentation?.title ?? entry.data.title;
const description = presentation?.description ?? entry.data.sub ?? `A case study in ${entry.data.sector}.`;
const { Content } = await render(entry);
const facts = [
  { label: 'Role', value: entry.data.role, icon: 'user' },
  { label: 'Sector', value: entry.data.sector, icon: 'building' },
  { label: 'Timeline', value: entry.data.duration, icon: 'clock' },
  ...(presentation ? [
    { label: 'Scale', value: presentation.scale, icon: 'layers' },
    { label: 'Outcome', value: presentation.outcome, icon: 'target' },
  ] : []),
];
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Jody Brewster', item: 'https://jodybrewster.dev/' },
    { '@type': 'ListItem', position: 2, name: 'Work', item: 'https://jodybrewster.dev/work' },
    { '@type': 'ListItem', position: 3, name: entry.data.title, item: `https://jodybrewster.dev/work/${entry.id}` },
  ],
};
---
<Studio title={`${title} — Case Study — Jody Brewster`} description={description} jsonLd={jsonLd} markdownHref={`${Astro.url.pathname.replace(/\/$/, '')}.md`}>
  <main id="main-content" class="case-main studio-container">
    <article>
      <header class="case-header">
        <a href="/work" class="case-back"><Icon name="arrow-left" class="icon" /> Back to Work</a>
        <h1>{title}</h1>
        <p>{description}</p>
      </header>

      <div class="case-overview">
        <div class="case-visual-column">
          {presentation?.image ? (
            <figure class="case-figure">
              <a class="case-image-link" href={entry.id === 'lennar-interactive-maps' ? '/portfolio/lennar-interactive-maps' : presentation.image} aria-label={entry.id === 'lennar-interactive-maps' ? 'View the Lennar product screenshots' : 'View the full-size Brand Impact Tracker interface'}>
                <img src={presentation.image} alt={presentation.alt} width="1280" height="960" fetchpriority="high" />
                <span class="case-preview-link"><Icon name="external" class="icon" />{entry.id === 'lennar-interactive-maps' ? 'Explore product screens' : 'View full interface'}</span>
              </a>
              <figcaption>{presentation.imageNote}</figcaption>
            </figure>
          ) : entry.id === 'pharmacy-agent-eval' ? (
            <figure class="case-figure">
              <div class="case-evaluation-preview"><WorkEvaluationPreview /></div>
              <figcaption>The evaluation framework · Four dimensions of conversation quality</figcaption>
            </figure>
          ) : null}
          {presentation && <ul class="studio-tags" aria-label="Project topics">{presentation.tags.map(tag => <li>{tag}</li>)}</ul>}
        </div>
        <aside class="case-facts" aria-labelledby="case-facts-title">
          <h2 id="case-facts-title" class="studio-eyebrow">At a glance</h2>
          <dl>{facts.map(fact => <div class="case-fact"><Icon name={fact.icon} class="icon" /><div><dt>{fact.label}</dt><dd>{fact.value}</dd></div></div>)}</dl>
        </aside>
      </div>

      {presentation && <>
        <div class="case-summary">
          <section aria-labelledby="challenge-title"><h2 id="challenge-title">The Challenge</h2><p>{presentation.challenge}</p></section>
          <section aria-labelledby="solution-title"><h2 id="solution-title">The Solution</h2><p>{presentation.solution}</p></section>
        </div>
        <section class="case-architecture" aria-labelledby="architecture-title">
          <div class="case-section-heading"><h2 id="architecture-title">{entry.id === 'pharmacy-agent-eval' ? 'Evaluation approach' : 'Architecture'}</h2><span>A system, end to end</span></div>
          <ol class="architecture-flow">
            {presentation.architecture.map((step, index) => <li class={`architecture-step architecture-step-${index + 1}`}><span class="architecture-icon"><Icon name={step.icon} class="icon" /></span><h3>{step.title}</h3><ul>{step.items.map(item => <li>{item}</li>)}</ul>{index < presentation.architecture.length - 1 && <span class="architecture-connector" aria-hidden="true"><Icon name="arrow-right" class="icon" /></span>}</li>)}
          </ol>
        </section>
      </>}

      <section class="case-story" aria-labelledby="case-story-title">
        <div class="case-story-heading"><p class="studio-eyebrow">Inside the engagement</p><h2 id="case-story-title">The decisions behind the work.</h2><p>{entry.data.title}</p></div>
        <div class="case-prose brief-shell"><Content /></div>
      </section>
      <footer class="case-footer"><a href="/work" class="studio-text-link"><Icon name="arrow-left" class="icon" /> All work & case studies</a><a href={`${Astro.url.pathname.replace(/\/$/, '')}.md`} class="studio-text-link">Read as Markdown <Icon name="file" class="icon" /></a></footer>
    </article>
  </main>
</Studio>

<style>
  .case-main { padding-top: 32px; padding-bottom: 64px; }
  .case-header { margin-bottom: 28px; }
  .case-back { display: inline-flex; align-items: center; gap: 8px; font-size: 12px; font-weight: 500; color: var(--studio-muted); border: none; margin-bottom: 25px; }
  .case-back .icon { width: 15px; height: 15px; }
  .case-back:hover { color: var(--studio-cyan); }
  .case-header h1 { font: 400 clamp(32px, 3vw, 42px)/1.15 var(--headline); letter-spacing: -.01em; margin: 0 0 12px; max-width: 32ch; }
  .case-header > p { margin: 0; font-size: 15px; font-weight: 400; line-height: 1.65; color: var(--studio-muted); }
  .case-overview { display: grid; grid-template-columns: minmax(0, 1.65fr) minmax(270px, 1fr); align-items: start; gap: 30px; }
  .case-visual-column { min-width: 0; }
  .case-figure { margin: 0 0 15px; }
  .case-image-link { position: relative; display: block; overflow: hidden; border-radius: 10px; border: 1px solid var(--studio-rule); background: var(--studio-surface); }
  .case-image-link img { display: block; width: 100%; height: auto; transition: transform 400ms; }
  .case-image-link:hover img { transform: scale(1.02); }
  .case-preview-link { position: absolute; bottom: 20px; left: 50%; transform: translateX(-50%); display: inline-flex; align-items: center; justify-content: center; gap: 8px; white-space: nowrap; border: 1px solid var(--studio-rule); border-radius: 99px; padding: 11px 17px; font-size: 11px; font-weight: 600; color: var(--studio-ink); background: var(--studio-bg); }
  .case-preview-link .icon { width: 15px; height: 15px; }
  .case-figure figcaption { font-family: var(--sans); font-size: 10px; line-height: 1.5; color: var(--studio-muted); padding: 10px 1px 0; }
  .case-evaluation-preview { aspect-ratio: 4 / 3; border: 1px solid var(--studio-rule); border-radius: 10px; overflow: hidden; }
  .case-facts { border: 1px solid var(--studio-rule); border-radius: 10px; padding: 26px; background: var(--studio-surface); }
  .case-facts h2 { margin: 0 0 24px; }
  .case-facts dl { margin: 0; display: grid; gap: 22px; }
  .case-fact { display: grid; grid-template-columns: 20px 1fr; align-items: start; gap: 14px; }
  .case-fact > .icon { width: 19px; height: 19px; margin-top: 2px; color: var(--studio-muted); }
  .case-fact dt { color: var(--studio-muted); font-size: 10px; font-weight: 500; line-height: 1.6; margin: 0 0 3px; }
  .case-fact dd { color: var(--studio-ink); font-size: 12px; line-height: 1.6; font-weight: 400; margin: 0; }
  .case-summary { display: grid; grid-template-columns: 1fr 1fr; gap: 40px; margin: 38px 0; }
  .case-summary h2, .case-section-heading h2 { font: 700 20px/1.3 var(--sans); letter-spacing: -.02em; margin: 0 0 12px; }
  .case-summary p { font-size: 13px; line-height: 1.8; color: var(--studio-muted); margin: 0; font-weight: 400; }
  .case-architecture { margin-bottom: 56px; }
  .case-section-heading { display: flex; align-items: center; justify-content: space-between; gap: 20px; margin-bottom: 16px; }
  .case-section-heading h2 { margin-bottom: 0; }
  .case-section-heading > span { color: var(--studio-muted); font-size: 11px; }
  .architecture-flow { margin: 0; padding: 0; list-style: none; display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 30px; }
  .architecture-step { --step-accent: var(--studio-cyan); position: relative; border: 1px solid color-mix(in srgb, var(--step-accent) 65%, var(--studio-rule)); border-radius: 10px; background: var(--studio-surface); padding: 20px 15px; }
  .architecture-step-2 { --step-accent: var(--studio-cyan); }
  .architecture-step-3 { --step-accent: var(--studio-purple); }
  .architecture-step-4 { --step-accent: var(--studio-orange); }
  .architecture-icon { display: flex; align-items: center; justify-content: center; width: 35px; height: 35px; margin: 0 0 13px; border: 1px solid var(--studio-rule); background: var(--studio-raised); border-radius: 7px; color: var(--step-accent); }
  .architecture-icon .icon { width: 20px; height: 20px; }
  .architecture-step h3 { color: var(--step-accent); font: 650 12px/1.5 var(--sans); margin: 0 0 12px; }
  .architecture-step ul { padding: 0; list-style: none; display: grid; gap: 8px; }
  .architecture-step ul li { font: 400 11px/1.5 var(--sans); color: var(--studio-muted); }
  .architecture-connector { position: absolute; right: -26px; top: 50%; color: var(--studio-muted); }
  .architecture-connector .icon { width: 20px; height: 20px; }
  .case-story { padding-top: 45px; border-top: 1px solid var(--studio-rule); }
  .case-story-heading { margin-bottom: 36px; }
  .case-story-heading h2 { font: 700 clamp(25px, 3vw, 34px)/1.25 var(--sans); letter-spacing: -.035em; margin: 12px 0; }
  .case-story-heading > p:last-child { font-size: 13px; color: var(--studio-muted); line-height: 1.7; }
  .case-prose { max-width: 930px; }
  .case-prose :global(> h2) { color: var(--studio-cyan); font-family: var(--sans); font-size: 10px; letter-spacing: .16em; margin-top: 40px; }
  .case-prose :global(> h3) { font: 650 clamp(22px, 2.5vw, 29px)/1.3 var(--sans); letter-spacing: -.025em; max-width: 34ch; }
  .case-prose :global(> p), .case-prose :global(> ul), .case-prose :global(> ol) { font: 400 15px/1.85 var(--sans); color: var(--studio-muted); max-width: 75ch; }
  .case-prose :global(strong) { color: var(--studio-ink); }
  .case-prose :global(.diagram) { border-radius: 10px; border-color: var(--studio-rule); background: var(--studio-surface); }
  .case-prose :global(.diagram .caption .icon) { width: 14px; height: 14px; flex-shrink: 0; margin: 0; }
  .case-prose :global(.metric) { background: var(--studio-surface); border-color: var(--studio-cyan); border-radius: 0 10px 10px 0; }
  .case-prose :global(.metric .n) { font: 650 42px/1.1 var(--sans); letter-spacing: -.04em; }
  .case-prose :global(.metric .c) { font: 400 12px/1.6 var(--sans); color: var(--studio-muted); }
  .case-prose :global(.metric .l) { line-height: 1.6; color: var(--studio-muted); }
  .case-prose :global(img) { max-width: 100%; height: auto; }
  .case-prose :global(hr) { border-color: var(--studio-rule); }
  .case-footer { display: flex; justify-content: space-between; gap: 20px; flex-wrap: wrap; border-top: 1px solid var(--studio-rule); margin-top: 48px; padding-top: 25px; }
  @media (max-width: 900px) and (min-width: 721px) {
    .case-overview { gap: 22px; grid-template-columns: minmax(0, 1.3fr) minmax(240px, 1fr); }
    .case-facts { padding: 20px; }
    .architecture-flow { gap: 22px; }
    .architecture-step { padding: 16px 12px; }
    .architecture-connector { right: -22px; }
  }
  @media (max-width: 720px) {
    .case-main { padding-top: 20px; padding-bottom: 40px; }
    .case-header { margin-bottom: 22px; }
    .case-back { margin-bottom: 21px; }
    .case-header h1 { font-size: 28px; }
    .case-header > p { font-size: 13px; }
    .case-overview { grid-template-columns: 1fr; gap: 24px; }
    .case-facts { padding: 22px; }
    .case-facts dl { gap: 18px; }
    .case-summary { grid-template-columns: 1fr; gap: 25px; margin: 32px 0; }
    .case-section-heading > span { display: none; }
    .architecture-flow { grid-template-columns: 1fr 1fr; gap: 16px; }
    .architecture-step { padding: 18px 14px; }
    .architecture-connector { display: none; }
    .architecture-step h3 { font-size: 12px; }
    .architecture-step ul li { font-size: 10px; }
    .case-story { padding-top: 30px; }
    .case-prose :global(> p) { font-size: 14px; }
    .case-prose :global(.diagram) { padding: 16px 10px; }
    .case-prose :global(.diagram .caption) { font-size: 10px; line-height: 1.6; align-items: flex-start; }
  }
  @media (prefers-reduced-motion: reduce) {
    .case-image-link img { transition: none; }
    .case-image-link:hover img { transform: none; }
  }
</style>
