---
import { getCollection, getEntry, render } from 'astro:content';
import Studio from '../../layouts/Studio.astro';
import Icon from '../../components/Icon.astro';
import CaseVisual from '../../components/case/CaseVisual.astro';
import CaseFacts from '../../components/case/CaseFacts.astro';
import CaseSummary from '../../components/case/CaseSummary.astro';
import CaseArchitecture from '../../components/case/CaseArchitecture.astro';
import ImageLightbox from '../../components/case/ImageLightbox.astro';
import { workPresentation } from '../../lib/work-presentation';
import { mediaTransitionName } from '../../lib/transition-names';

export async function getStaticPaths() {
  const published = await getCollection('work', b => !b.data.draft);
  return published.map((entry) => ({ params: { slug: entry.id } }));
}

const { slug } = Astro.params;
const entry = slug ? await getEntry('work', slug) : undefined;
if (!entry || entry.data.draft) return new Response('Not found', { status: 404 });
const presentation = workPresentation[entry.id];
const title = presentation?.title ?? entry.data.title;
const description = presentation?.description ?? entry.data.sub ?? `A case study in ${entry.data.sector}.`;
const { Content } = await render(entry);
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Jody Brewster', item: 'https://jodybrewster.dev/' },
    { '@type': 'ListItem', position: 2, name: 'Work', item: 'https://jodybrewster.dev/work' },
    { '@type': 'ListItem', position: 3, name: entry.data.title, item: `https://jodybrewster.dev/work/${entry.id}` },
  ],
};
---
<Studio title={`${title} — Case Study — Jody Brewster`} description={description} jsonLd={jsonLd} markdownHref={`${Astro.url.pathname.replace(/\/$/, '')}.md`}>
  <main id="main-content" class="case-main studio-container">
    <article>
      <header class="case-header">
        <a href="/work" class="case-back"><Icon name="arrow-left" class="icon" /> Back to Work</a>
        <h1 class="enter-title">{title}</h1>
        <p>{description}</p>
      </header>

      <div class="case-overview">
        <div class="case-visual-column">
          <CaseVisual slug={entry.id} presentation={presentation} transitionName={mediaTransitionName(Astro.url.pathname)} />
          {presentation && <ul class="studio-tags" aria-label="Project topics">{presentation.tags.map(tag => <li>{tag}</li>)}</ul>}
        </div>
        <CaseFacts role={entry.data.role} sector={entry.data.sector} duration={entry.data.duration} presentation={presentation} />
      </div>

      {presentation && <>
        <CaseSummary presentation={presentation} />
        <CaseArchitecture slug={entry.id} presentation={presentation} />
      </>}

      <section class="case-story" aria-labelledby="case-story-title">
        <div class="case-story-heading"><p class="studio-eyebrow">Inside the engagement</p><h2 id="case-story-title">The decisions behind the work.</h2><p>{entry.data.title}</p></div>
        <div class="case-prose brief-shell"><Content /></div>
      </section>
      <footer class="case-footer"><a href="/work" class="studio-text-link"><Icon name="arrow-left" class="icon" /> All work & case studies</a><a href={`${Astro.url.pathname.replace(/\/$/, '')}.md`} class="studio-text-link">Read as Markdown <Icon name="file" class="icon" /></a></footer>
    </article>
    <ImageLightbox />
  </main>
</Studio>

<style>
  .case-main { padding-top: 32px; padding-bottom: 64px; }
  .case-header { margin-bottom: 28px; }
  .case-back { display: inline-flex; align-items: center; gap: 8px; font-size: 12px; font-weight: 500; color: var(--studio-muted); border: none; margin-bottom: 25px; }
  .case-back .icon { width: 15px; height: 15px; }
  .case-back:hover { color: var(--studio-cyan); }
  .case-header h1 { font: 400 clamp(32px, 3vw, 42px)/1.15 var(--headline); letter-spacing: -.01em; margin: 0 0 12px; max-width: 32ch; }
  .case-header > p { margin: 0; font-size: 15px; font-weight: 400; line-height: 1.65; color: var(--studio-muted); }
  .case-overview { display: grid; grid-template-columns: minmax(0, 1.65fr) minmax(270px, 1fr); align-items: start; gap: 30px; }
  .case-visual-column { min-width: 0; }
  .case-story { padding-top: 45px; border-top: 1px solid var(--studio-rule); }
  .case-story-heading { margin-bottom: 36px; }
  .case-story-heading h2 { font: 700 clamp(25px, 3vw, 34px)/1.25 var(--sans); letter-spacing: -.035em; margin: 12px 0; }
  .case-story-heading > p:last-child { font-size: 13px; color: var(--studio-muted); line-height: 1.7; }
  .case-prose { max-width: 930px; }
  .case-prose :global(> h2) { color: var(--studio-cyan); font-family: var(--sans); font-size: 10px; letter-spacing: .16em; margin-top: 40px; }
  .case-prose :global(> h3) { font: 650 clamp(22px, 2.5vw, 29px)/1.3 var(--sans); letter-spacing: -.025em; max-width: 34ch; }
  .case-prose :global(> p), .case-prose :global(> ul), .case-prose :global(> ol) { font: 400 15px/1.85 var(--sans); color: var(--studio-muted); max-width: 75ch; }
  .case-prose :global(strong) { color: var(--studio-ink); }
  .case-prose :global(.diagram) { border-radius: 10px; border-color: var(--studio-rule); background: var(--studio-surface); }
  .case-prose :global(.diagram .caption .icon) { width: 14px; height: 14px; flex-shrink: 0; margin: 0; }
  .case-prose :global(.metric) { background: var(--studio-surface); border-color: var(--studio-cyan); border-radius: 0 10px 10px 0; }
  .case-prose :global(.metric .n) { font: 650 42px/1.1 var(--sans); letter-spacing: -.04em; }
  .case-prose :global(.metric .c) { font: 400 12px/1.6 var(--sans); color: var(--studio-muted); }
  .case-prose :global(.metric .l) { line-height: 1.6; color: var(--studio-muted); }
  .case-prose :global(img) { max-width: 100%; height: auto; }
  /* Inline screenshots float small beside the text and open full size in the
     lightbox. Paragraphs stop at 75ch, so a right float is pulled in by the
     space left of that line or it would sit in the empty gutter unwrapped;
     the figure shares the paragraph font so its ch is the paragraph's ch. */
  .case-prose :global(> h2) { clear: both; }
  .case-prose :global(> ul), .case-prose :global(> ol) { overflow: hidden; }
  .case-prose :global(.case-shot) { clear: both; width: min(280px, 40%); margin: 8px 0 18px; font: 400 15px/1.85 var(--sans); }
  .case-prose :global(.case-shot-left) { float: left; margin-right: 28px; }
  .case-prose :global(.case-shot-right) { float: right; margin-left: 28px; margin-right: max(0px, calc(100% - 75ch)); }
  .case-prose :global(.case-shot img) { display: block; width: 100%; border: 1px solid var(--studio-rule); border-radius: 8px; transition: border-color 150ms; }
  .case-prose :global(.case-shot img:hover) { border-color: var(--studio-cyan); }
  .case-prose :global(.case-shot figcaption) { margin-top: 8px; font-size: 11px; line-height: 1.5; color: var(--studio-muted); }
  .case-prose :global(hr) { border-color: var(--studio-rule); }
  .case-footer { display: flex; justify-content: space-between; gap: 20px; flex-wrap: wrap; border-top: 1px solid var(--studio-rule); margin-top: 48px; padding-top: 25px; }
  @media (max-width: 900px) and (min-width: 721px) {
    .case-overview { gap: 22px; grid-template-columns: minmax(0, 1.3fr) minmax(240px, 1fr); }
  }
  @media (max-width: 720px) {
    .case-main { padding-top: 20px; padding-bottom: 40px; }
    .case-header { margin-bottom: 22px; }
    .case-back { margin-bottom: 21px; }
    .case-header h1 { font-size: 28px; }
    .case-header > p { font-size: 13px; }
    .case-overview { grid-template-columns: 1fr; gap: 24px; }
    .case-story { padding-top: 30px; }
    .case-prose :global(> p) { font-size: 14px; }
    .case-prose :global(.case-shot-left), .case-prose :global(.case-shot-right) { float: none; width: 100%; margin: 20px 0; }
    .case-prose :global(.diagram) { padding: 16px 10px; }
    .case-prose :global(.diagram .caption) { font-size: 10px; line-height: 1.6; align-items: flex-start; }
  }
</style>
